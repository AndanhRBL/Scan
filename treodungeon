-- KITING V45 - BOSS & QUÁI THƯỜNG
-- =====================================================
local Kiting = {}
local TargetTypeCache = {}
local function isEnemyCastingOrAttacking(enemy)
    if not enemy or not enemy.Parent then return false end
    local h = enemy:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    local anim = h:FindFirstChildOfClass("Animator")
    if not anim then return false end
    for _, track in pairs(anim:GetPlayingAnimationTracks()) do
        if not track.Looped and track.Speed > 0.1 and track.Length > 0 then
            local n = track.Animation and track.Animation.Name:lower() or ""
            if n:find("attack") or n:find("cast") or n:find("slash")
               or n:find("swing") or n:find("shoot") or n:find("skill")
               or n:find("smash") or n:find("spin") or n:find("charge") then
                return true
            end
        end
    end
    local ev = enemy:FindFirstChild("EnemyValues")
    if ev then
        for _, vn in pairs({"IsAttacking", "Casting", "UsingSkill"}) do
            local val = ev:FindFirstChild(vn)
            if val and val.Value == true then return true end
        end
    end
    return false
end
function Kiting.GetIdealDistance(enemy)
    local isBoss = BossDetect.IsBoss(enemy)
    return isBoss and Config.BossKiteDistance or Config.KiteDistance
end
function Kiting.GetRetreatDistance(enemy)
    local isBoss = BossDetect.IsBoss(enemy)
    return isBoss and Config.BossRetreatDistance or Config.RetreatDistance
end
function Kiting.GetKitePosition(hrp, enemyPos, enemy, dt)
    local myPos = hrp.Position
    local toMe = myPos - enemyPos
    local flatToMe = Vector3.new(toMe.X, 0, toMe.Z)
    local currentDist = flatToMe.Magnitude
    if currentDist < 0.1 then
        flatToMe = Vector3.new(1, 0, 0)
        currentDist = 1
    end
    local awayDir = flatToMe.Unit
    local isBoss = BossDetect.IsBoss(enemy)
    local idealDist = isBoss and Config.BossKiteDistance or Config.KiteDistance
    local retreatDist = isBoss and Config.BossRetreatDistance or Config.RetreatDistance
    _G.IdealKiteDistance = idealDist
    local isAttacking = Config.DetectAttack and isEnemyCastingOrAttacking(enemy)
    if isAttacking then
        State.IsTargetAttacking = true
        State.AttackWarningTime = tick()
    elseif tick() - State.AttackWarningTime > 0.8 then
        State.IsTargetAttacking = false
    end
    local shouldRetreat = currentDist < retreatDist or State.IsTargetAttacking
    if shouldRetreat then
        local retreatDir = awayDir
        local clearDir, clearDist = Obstacle.FindClearDirection(myPos, retreatDir, 10)
        local targetDist = math.max(idealDist * 1.1, retreatDist + 8)
        local candidatePos = enemyPos + clearDir * targetDist
        return candidatePos, "retreat"
    end
    local distDiff = math.abs(currentDist - idealDist)
    if distDiff <= 4.0 and not State.IsTargetAttacking then
        if tick() - State.LastDirChange > Config.CircleDirChange then
            if math.random() < 0.25 then State.KiteDirection = -State.KiteDirection end
            State.LastDirChange = tick()
        end
        State.CurrentKiteAngle = (State.CurrentKiteAngle + State.KiteDirection * Config.CircleSpeed * dt) % (2 * math.pi)
        local perpDir = Vector3.new(-awayDir.Z, 0, awayDir.X) * State.KiteDirection
        local circleBlend = 0.85
        local radialBlend = (idealDist - currentDist) * 0.15
        local moveDir = (perpDir * circleBlend + awayDir * radialBlend).Unit
        local clearDir, clearDist = Obstacle.FindClearDirection(myPos, moveDir, 8)
        if clearDist < 4.0 then
            State.KiteDirection = -State.KiteDirection
            State.LastDirChange = tick()
            moveDir = Vector3.new(awayDir.Z, 0, -awayDir.X) * State.KiteDirection
            clearDir = Obstacle.FindClearDirection(myPos, moveDir, 8)
        end
        local stepDist = 8.0
        local circlePos = myPos + clearDir * stepDist
        local enemyToCircle = (circlePos - enemyPos)
        local flatCircleDist = Vector3.new(enemyToCircle.X, 0, enemyToCircle.Z).Magnitude
        if flatCircleDist < retreatDist then
            circlePos = enemyPos + (circlePos - enemyPos).Unit * idealDist
        end
        return circlePos, "circle"
    end
    if currentDist > idealDist + 4.0 then
        local approachDir = -awayDir
        local clearDir = Obstacle.FindClearDirection(myPos, approachDir, 10)
        local targetApproachDist = idealDist + 1.0
        local approachPos = enemyPos + awayDir * targetApproachDist
        return approachPos, "approach"
    end
    return myPos, "hold"
end
function Kiting.Reset()
    State.IsKiting = false
    State.CurrentKiteAngle = 0
    State.LastDirChange = tick()
    State.IsTargetAttacking = false
    State.AttackWarningTime = 0
end
