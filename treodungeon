local function getPos(obj)
    if not obj or not obj.Parent then return nil end
    local hrp = obj:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if h and h.RootPart then return h.RootPart.Position end
    local pp = obj.PrimaryPart
    if pp then return pp.Position end
    local torso = obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("Torso")
    if torso then return torso.Position end
    local head = obj:FindFirstChild("Head")
    if head then return head.Position end
    local bp = obj:FindFirstChildWhichIsA("BasePart")
    if bp then return bp.Position end
    return nil
end

local function getHP(obj)
    if not obj then return 0, 1 end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if h then return h.Health, h.MaxHealth end
    return 100, 100
end

local function getVelocity(obj)
    local hrp = obj:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.AssemblyLinearVelocity end
    local pp = obj.PrimaryPart
    if pp then return pp.AssemblyLinearVelocity end
    return Vector3.new(0, 0, 0)
end

local function isKeywordMatch(text, keywords)
    if not text then return false end
    local lower = text:lower()
    for _, kw in pairs(keywords) do
        if lower:find(kw) then return true end
    end
    return false
end

