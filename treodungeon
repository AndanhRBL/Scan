-- OBSTACLE
-- =====================================================
local Obstacle = {}
local RayParams = nil
local Waypoints = {}
local CurrentWpIdx = 1
local function initRayParams()
    RayParams = RaycastParams.new()
    RayParams.FilterType = RaycastFilterType.Exclude
    local filter = {}
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    local dungeon = workspace:FindFirstChild("dungeon")
    if dungeon then
        local enemies = dungeon:FindFirstChild("enemies")
        if enemies then table.insert(filter, enemies) end
    end
    RayParams.FilterDescendantsInstances = filter
end
function Obstacle.IsBlocked(from, to)
    if not RayParams then initRayParams() end
    local dir = to - from
    local res = workspace:Raycast(from + Vector3.new(0, 1.5, 0), dir, RayParams)
    return res ~= nil and res.Instance ~= nil
end
function Obstacle.FindClearDirection(hrpPos, desiredDir, checkDist)
    checkDist = checkDist or 8
    local bestDir = desiredDir
    local bestClearDist = 0
    for angleDeg = -90, 90, 15 do
        local rad = math.rad(angleDeg)
        local testDir = Vector3.new(
            desiredDir.X * math.cos(rad) - desiredDir.Z * math.sin(rad),
            0,
            desiredDir.X * math.sin(rad) + desiredDir.Z * math.cos(rad)
        ).Unit
        local res = workspace:Raycast(hrpPos + Vector3.new(0, 1.5, 0), testDir * checkDist, RayParams)
        local clearDist = res and (res.Position - hrpPos).Magnitude or checkDist
        if clearDist > bestClearDist then
            bestClearDist = clearDist
            bestDir = testDir
            if clearDist >= checkDist then break end
        end
    end
    return bestDir, bestClearDist
end
function Obstacle.CalculatePath(from, to)
    initRayParams()
    local path = PathfindingService:CreatePath({
        AgentRadius = 2.0, AgentHeight = 5.0,
        AgentCanJump = true, AgentCanClimb = false,
        WaypointSpacing = 4.0,
    })
    local ok = pcall(function() path:ComputeAsync(from, to) end)
    if ok and path.Status == Enum.PathStatus.Success then
        local wps = path:GetWaypoints()
        Waypoints = {}
        for _, wp in ipairs(wps) do table.insert(Waypoints, wp.Position) end
        CurrentWpIdx = 1
        return true
    end
    return false
end
function Obstacle.GetNextWaypoint(hrpPos)
    if #Waypoints == 0 then return nil end
    while CurrentWpIdx <= #Waypoints do
        local wp = Waypoints[CurrentWpIdx]
        local d = (Vector3.new(wp.X, hrpPos.Y, wp.Z) - hrpPos).Magnitude
        if d < 4.0 then CurrentWpIdx = CurrentWpIdx + 1 else return wp end
    end
    Waypoints = {}
    CurrentWpIdx = 1
    return nil
end
function Obstacle.HasPath() return #Waypoints > 0 and CurrentWpIdx <= #Waypoints end
function Obstacle.ClearWaypoints() Waypoints = {}; CurrentWpIdx = 1 end
-- =====================================================
-- PATHFINDING (BodyGyro + MoveTo)
-- =====================================================
local Pathfinding = {}
local LastMoveCall = 0
local LastPathGen = 0
function Pathfinding.MoveTo(targetPos, dt, faceTargetPos)
    local c = LocalPlayer.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not h or h.Health <= 0 then return end
    if Config.FaceTargetInCombat and faceTargetPos then
        Smooth.FaceTarget(hrp, faceTargetPos)
    else
        Smooth.ClearGyro()
    end
    local d = (Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z) - hrp.Position).Magnitude
    if d < 1.5 then h:Move(Vector3.zero); return end
    if not Obstacle.IsBlocked(hrp.Position, targetPos) then
        Obstacle.ClearWaypoints()
        local dir = (targetPos - hrp.Position).Unit
        local moveDir = Vector3.new(dir.X, 0, dir.Z).Unit
        h:Move(moveDir)
        return
    end
    if not Obstacle.HasPath() and tick() - LastPathGen > Config.PathRecalcInterval then
        LastPathGen = tick()
        Obstacle.CalculatePath(hrp.Position, targetPos)
    end
    local nextWp = Obstacle.GetNextWaypoint(hrp.Position)
    if nextWp then
        local dir = (nextWp - hrp.Position).Unit
        local moveDir = Vector3.new(dir.X, 0, dir.Z).Unit
        h:Move(moveDir)
    else
        local desiredDir = Vector3.new((targetPos - hrp.Position).X, 0, (targetPos - hrp.Position).Z).Unit
        local clearDir = Obstacle.FindClearDirection(hrp.Position, desiredDir, 8)
        h:Move(clearDir)
    end
end
function Pathfinding.Stop()
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then h:Move(Vector3.zero) end
    Smooth.ClearGyro()
    Obstacle.ClearWaypoints()
end
function Pathfinding.StopAndFace(faceTargetPos)
    local c = LocalPlayer.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then h:Move(Vector3.zero) end
    if hrp and faceTargetPos and Config.FaceTargetInCombat then
        Smooth.FaceTarget(hrp, faceTargetPos)
    end
end
function Pathfinding.Reset() Obstacle.ClearWaypoints(); Smooth.ClearGyro() end
