-- 7. KITING CHUẨN XÁC TỪ V35 (KHÔNG TELE, KHÔNG GIẬT)
-- ====================================================================
local KitingSystem = {}

local function isEnemyAttacking(enemy)
    if not enemy then return false end
    local hum = enemy:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
        local anim = track.Animation
        local name = (anim and anim.Name:lower()) or (track.Name:lower())
        if name:find("attack") or name:find("cast") or name:find("swing") or name:find("smash") or name:find("laser") or name:find("slash") then
            if track.TimePosition > 0.05 and track.TimePosition < track.Length * 0.9 then
                return true
            end
        end
    end
    return false
end

function KitingSystem.CalculateSafePosition(myPos, enemyPos, isBossEnemy, enemyObj, threats)
    local desiredDist = isBossEnemy and Config.KiteDistanceBoss or Config.KiteDistance
    if isEnemyAttacking(enemyObj) then
        desiredDist = desiredDist + Config.AttackRetreatExtra
    end

    local flatEnemy = Vector3.new(enemyPos.X, myPos.Y, enemyPos.Z)
    local awayDir = (myPos - flatEnemy)
    if awayDir.Magnitude < 0.1 then
        awayDir = Vector3.new(1, 0, 0)
    else
        awayDir = awayDir.Unit
    end

    State.StrafeAngle = (State.StrafeAngle + (Config.CircleStrafeSpeed * 0.05 * State.StrafeDir)) % (math.pi * 2)
    local perpDir = Vector3.new(-awayDir.Z, 0, awayDir.X) * math.sin(State.StrafeAngle) * 0.6
    local combinedDir = (awayDir + perpDir).Unit

    local candidatePos = flatEnemy + (combinedDir * desiredDist)

    local isDangerous = DodgeSystem.IsPositionDangerous(candidatePos, threats)
    if not isDangerous then
        return candidatePos
    end

    local bestPos = candidatePos
    for i = 1, Config.RetreatSampleAngles do
        local angle = (i / Config.RetreatSampleAngles) * math.pi * 2
        local rotDir = Vector3.new(
            awayDir.X * math.cos(angle) - awayDir.Z * math.sin(angle),
            0,
            awayDir.X * math.sin(angle) + awayDir.Z * math.cos(angle)
        ).Unit

        local testPos = flatEnemy + (rotDir * desiredDist)
        local isDang = DodgeSystem.IsPositionDangerous(testPos, threats)
        if not isDang then
            bestPos = testPos
            break
        end
    end

    return bestPos
end

