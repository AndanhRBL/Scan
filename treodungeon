local AutoTarget = {}
local ModelCache = {}
local LastCacheUpdate = 0

local function isEnemy(obj)
    if not obj or not obj:IsA("Model") or obj == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 or h.MaxHealth <= 0 then return false end
    local hasRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("Torso") or obj.PrimaryPart
    if not hasRoot then return false end
    if obj:FindFirstChild("enemyNameplate", true) then return true end
    local name = obj.Name:lower()
    if name:find("npc") or name:find("vendor") or name:find("shop") or name:find("guide") then return false end
    for _, kw in pairs({"enemy", "mob", "monster", "boss", "skeleton", "zombie", "demon", "knight", "mage", "archer", "giant", "titan", "yeti", "orc", "warrior", "brute", "golem", "wraith", "crab", "shark", "serpent"}) do
        if name:find(kw) then return true end
    end
    local otherPlayers = 0
    for _, plr in pairs(Players:GetPlayers()) do if plr ~= LocalPlayer and plr.Character then otherPlayers = otherPlayers + 1 end end
    if otherPlayers == 0 and obj:FindFirstChild("HumanoidRootPart") then return true end
    return false
end

local function recursiveCollect(root, list, depth)
    for _, obj in pairs(root:GetChildren()) do
        if obj:IsA("Model") then
            table.insert(list, obj)
            if depth < 8 then recursiveCollect(obj, list, depth + 1) end
        elseif obj:IsA("Folder") and depth < 8 then
            recursiveCollect(obj, list, depth + 1)
        end
    end
end

local function updateModelCache(force)
    if not force and tick() - LastCacheUpdate < 0.3 then return end
    LastCacheUpdate = tick()
    local list = {}
    recursiveCollect(workspace, list, 1)
    ModelCache = list
end

function AutoTarget.GetBestEnemy()
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    updateModelCache()

    local best, bestScore = nil, math.huge
    for _, obj in pairs(ModelCache) do
        if obj.Parent and isEnemy(obj) then
            local pos = getPos(obj)
            if pos then
                local d = (pos - myPos).Magnitude
                if d <= Config.FarmRange then
                    local isBoss = BossDetect.IsBoss(obj)
                    local score = isBoss and (d * 0.8) or d
                    if score < bestScore then bestScore = score; best = obj end
                end
            end
        end
    end
    return best
end

function AutoTarget.FindNearestChest()
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local nearest, nearDist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and (obj.Name:lower():find("chest") or obj.Name:lower():find("reward")) then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt", true)
            if prompt then
                local pos = obj:IsA("BasePart") and obj.Position or getPos(obj)
                if pos then
                    local d = (pos - myPos).Magnitude
                    if d < nearDist and d <= 100 then nearDist = d; nearest = obj end
                end
            end
        end
    end
    return nearest
end

function AutoTarget.FindNearestPortal()
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local nearest, nearDist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("portal") or name:find("door") or name:find("exit") or name:find("bossroom") then
                local pos = obj:IsA("BasePart") and obj.Position or getPos(obj)
                if pos then
                    local d = (pos - myPos).Magnitude
                    if d < nearDist and d <= 300 then nearDist = d; nearest = obj end
                end
            end
        end
    end
    return nearest
end

