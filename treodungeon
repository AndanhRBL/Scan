local EnemyTargeting = {}
local function getRoot(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
end

local function isTargetValid(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local root = getRoot(model)
    if not root then return false end
    return true
end

function EnemyTargeting.FindBestTarget()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myRoot = getRoot(myChar)
    if not myRoot then return nil end

    local bestTarget = nil
    local bestDist = Config.FarmRange
    local searchContainers = {}

    local dungeon = workspace:FindFirstChild("dungeon")
    if dungeon then table.insert(searchContainers, dungeon) end
    local enemies = workspace:FindFirstChild("enemies") or workspace:FindFirstChild("Enemies")
    if enemies then table.insert(searchContainers, enemies) end
    table.insert(searchContainers, workspace)

    for _, container in ipairs(searchContainers) do
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Model") and obj ~= myChar and not Players:GetPlayerFromCharacter(obj) then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                local root = getRoot(obj)
                if hum and root and hum.Health > 0 then
                    local dist = (root.Position - myRoot.Position).Magnitude
                    if dist <= bestDist then
                        if isBoss(obj) and dist < 120 then
                            return obj
                        end
                        bestDist = dist
                        bestTarget = obj
                    end
                end
            end
        end
        if bestTarget then break end
    end
    return bestTarget
end

