local function getPos(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("Model") then
        local pp = obj.PrimaryPart
        if pp then return pp.Position end
        local h = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
        if h then return h.Position end
        local p = obj:FindFirstChildWhichIsA("BasePart")
        if p then return p.Position end
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end
local function getHP(obj)
    if not obj or not obj.Parent then return 0 end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if h then return h.Health end
    local ev = obj:FindFirstChild("EnemyValues")
    if ev then
        local hp = ev:FindFirstChild("Health")
        if hp then return hp.Value end
    end
    return 0
end
local function getMaxHP(obj)
    if not obj or not obj.Parent then return 100 end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if h then return h.MaxHealth end
    local ev = obj:FindFirstChild("EnemyValues")
    if ev then
        local mhp = ev:FindFirstChild("MaxHealth")
        if mhp then return mhp.Value end
    end
    return 100
end
