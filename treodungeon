local BossDetect = {}

function BossDetect.IsBoss(obj)
    if not obj or not obj.Parent then return false end
    local name = obj.Name:lower()
    if name:find("boss") or name:find("giant") or name:find("lord")
       or name:find("king") or name:find("titan") or name:find("elite")
       or name:find("champion") or name:find("dragon") or name:find("demon")
       or name:find("final") or name:find("overlord") or name:find("ancient") then
        return true
    end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if h and h.MaxHealth >= 2000 then return true end
    local ok, tags = pcall(function() return CollectionService:GetTags(obj) end)
    if ok and tags then
        for _, tag in pairs(tags) do
            local tl = tostring(tag):lower()
            if tl:find("boss") or tl:find("elite") or tl:find("champion") then return true end
        end
    end
    if obj:FindFirstChild("bossHealthBar", true) or obj:FindFirstChild("BossHealth", true) then return true end
    return false
end

-- Nhận diện trạng thái Dungeon chính xác qua PlayerGui (V35)
local function getDungeonState()
    local g = LocalPlayer:FindFirstChild("PlayerGui")
    if not g then return "unknown" end
    if g:FindFirstChild("countDownGui") then return "starting" end
    if g:FindFirstChild("timeLeftGui") then return "in_dungeon" end
    if g:FindFirstChild("completeGui") then return "completed" end
    if g:FindFirstChild("failedGui") then return "failed" end
    if isLobby() then return "lobby" end
