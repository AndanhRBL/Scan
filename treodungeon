function AutoStart.Update(dt)
    if not Config.AutoStart then return end
    if tick() - LastStartCheck < 0.8 then return end
    LastStartCheck = tick()
    if tick() - LastStartAction < 2.5 then return end

    local dState = getDungeonState()

    if dState == "waiting_start" or dState == "lobby" then
        selectBestDungeon()
        fireChangeStartValue()
        local btn = findStartButton()
        if btn then
            pcall(function()
                if firesignal then
                    firesignal(btn.MouseButton1Down)
                    firesignal(btn.MouseButton1Click)
                else
                    btn.MouseButton1Down:Fire()
                    btn.MouseButton1Click:Fire()
                end
            end)
            LastStartAction = tick()
            return
        end

        if isLobby() then
            pcall(function()
                local inLobby = false
                if workspace:FindFirstChild("games") then
                    for _, v in pairs(workspace.games.inLobby:GetChildren()) do
                        if v:FindFirstChild(LocalPlayer.Name) then inLobby = true; break end
                    end
                end
                local createLobby = Remotes:FindFirstChild("createLobby")
                local startDungeon = Remotes:FindFirstChild("startDungeon")
                if not inLobby and createLobby then
                    createLobby:InvokeServer(
                        Config.SelectedDungeon, Config.SelectedDifficulty, 0,
                        Config.Hardcore, true, false
                    )
                end
                if startDungeon then startDungeon:FireServer() end
                LastStartAction = tick()
            end)
        end
    end
end

