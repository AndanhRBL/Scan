-- 11. HỆ THỐNG AUTO FARM TỔNG HỢP (COMBAT & KITING V35)
-- ====================================================================
local AutoFarm = {}

function AutoFarm.AttackTarget(target)
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    if not remotes then return end
    local char = LocalPlayer.Character
    if not char then return end

    local weapon = char:FindFirstChildOfClass("Tool")
    if weapon then
        weapon:Activate()
    end

    local swingRemote = remotes:FindFirstChild("swingSword") or remotes:FindFirstChild("attack")
    if swingRemote then
        pcall(function() swingRemote:FireServer() end)
    end
end

function AutoFarm.Update(dt)
    if not Config.AutoFarm then
        CombatGyro.Disable()
        return
    end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = getRoot(myChar)
    local myHum = myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not myHum or myHum.Health <= 0 then return end

    pcall(RoomProgression.Update, dt)
    pcall(AutoSell.Update)

    if not isTargetValid(State.Target) then
        State.Target = EnemyTargeting.FindBestTarget()
        if not State.Target then
            CombatGyro.Disable()
            return
        end
    end

    local tRoot = getRoot(State.Target)
    if not tRoot then
        State.Target = nil
        CombatGyro.Disable()
        return
    end

    local tPos = tRoot.Position
    local myPos = myRoot.Position
    local dist = (tPos - myPos).Magnitude

    local threats = Config.AutoDodge and DodgeSystem.ScanThreats() or {}
    local isBossEnemy = isBoss(State.Target)

    local targetMovePos
    if Config.EnableKiting then
        targetMovePos = KitingSystem.CalculateSafePosition(myPos, tPos, isBossEnemy, State.Target, threats)
    else
        targetMovePos = tPos
    end

    myHum:MoveTo(targetMovePos)

    if dist <= Config.AttackRange + 15 then
        CombatGyro.FaceTarget(myRoot, tPos)
    else
        CombatGyro.Disable()
    end

    if dist <= Config.AttackRange then
        if tick() - State.LastAttack >= Config.AttackCooldown then
            AutoFarm.AttackTarget(State.Target)
            State.LastAttack = tick()
        end
    end
end

