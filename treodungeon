-- ====================================================================
local AutoFarm = {}
local CurrentTarget = nil
local LastTargetSearch = 0
local LastWeaponAttack = 0
local LastMoveAction = 0

function AutoFarm.Update(dt)
    if not Config.AutoFarm then return end
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not h or not hrp or h.Health <= 0 then return end

    Smooth.DisableAutoRotate(h)

    -- Kiểm tra hoàn thành ải -> Replay
    local dState = getDungeonState()
    local progress = workspace:FindFirstChild("dungeonProgress")
    local isDone = (dState == "completed") or (progress and progress.Value == "bossKilled")
    if isDone then
        Pathfinding.Stop()
        triggerReplayOrLobby()
        return
    end

    -- Tìm mục tiêu
    if tick() - LastTargetSearch > Config.TargetSearchInterval then
        if CurrentTarget then
            local hp = getHP(CurrentTarget)
            if not CurrentTarget.Parent or hp <= 0 then
                CurrentTarget = nil; _G.CurrentTarget = nil
                State.KillCount = State.KillCount + 1
                Pathfinding.Stop()
                Obstacle.ClearWaypoints()
                Kiting.Reset()
            end
        end

        if not CurrentTarget then
            CurrentTarget = AutoTarget.GetBestEnemy()
            _G.CurrentTarget = CurrentTarget
            if CurrentTarget then
                Obstacle.ClearWaypoints()
                Kiting.Reset()
                Pathfinding.Reset()
            else
                -- Mở rương khi hết quái
                if Config.AutoOpenChest then
                    local chest = AutoTarget.FindNearestChest()
                    if chest then
                        local pos = chest:IsA("BasePart") and chest.Position or getPos(chest)
                        if pos then
                            local d = (pos - hrp.Position).Magnitude
                            if d <= 10 then
                                local prompt = chest:FindFirstChildOfClass("ProximityPrompt", true)
                                if prompt then
                                    pcall(function()
                                        prompt:InputHoldBegin()
                                        task.wait(prompt.HoldDuration or 0.5)
                                        prompt:InputHoldEnd()
                                    end)
                                end
                            elseif d <= 150 then
                                Pathfinding.MoveTo(pos, dt, pos)
                            end
                        end
                    end
                end
                -- Tự động đi đến cửa qua phòng tiếp theo
                if Config.AutoClearRoom then
                    local portal = AutoTarget.FindNearestPortal()
                    if portal then
                        local pos = portal:IsA("BasePart") and portal.Position or getPos(portal)
                        if pos then
                            local d = (pos - hrp.Position).Magnitude
                            if d <= 6 then h:MoveTo(hrp.Position)
                            elseif d <= 250 then Pathfinding.MoveTo(pos, dt, pos) end
                        end
                    end
                end
            end
        end
        LastTargetSearch = tick()
    end

    -- Né đòn Telegraph (Laser đỏ / Cầu xoắn)
    if Config.AutoDodge then
        local inDanger, escapePos = scanAllHazards(hrp.Position)
        if inDanger and escapePos then
            if isSafeFloor(escapePos) then Pathfinding.MoveTo(escapePos, dt, escapePos) end
            h.Jump = true
            return
        end
    end

    -- Combat & Kiting
    if CurrentTarget and CurrentTarget.Parent then
        local pos = getPos(CurrentTarget)
        if pos then
            local d = (pos - hrp.Position).Magnitude
            local facePos = Vector3.new(pos.X, hrp.Position.Y, pos.Z)

            local function tryAttack(rangeBonus)
                if d <= Config.AttackRange + (rangeBonus or 0) and Config.AutoAttack and tick() - LastWeaponAttack >= Config.AttackCooldown then
                    local tool = c:FindFirstChildOfClass("Tool")
                    if tool then pcall(function() tool:Activate() end); LastWeaponAttack = tick() end
                    for _, acc in ipairs(c:GetChildren()) do
                        if acc:IsA("Accessory") and acc:FindFirstChild("Weapon") then
                            local wEv = acc:FindFirstChildOfClass("RemoteEvent")
                            if wEv then wEv:FireServer(); if Remotes:FindFirstChild("weaponUsed") then Remotes.weaponUsed:FireServer() end end
                            break
                        end
                    end
                end
            end

            if Config.EnableKiting then
                local kitePos, kiteAction = Kiting.GetKitePosition(hrp, pos, CurrentTarget, dt)
                if kiteAction == "retreat" and kitePos then
                    Pathfinding.MoveTo(kitePos, dt, facePos)
                    tryAttack(5)
                elseif kiteAction == "circle" and kitePos then
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        Pathfinding.MoveTo(kitePos, dt, facePos)
                    end
                    tryAttack(8)
                elseif kiteAction == "attack" or kiteAction == "hold" then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(0)
                elseif kiteAction == "approach" then
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        local predictTarget = pos
                        local vel = getVelocity(CurrentTarget)
                        if vel.Magnitude > 1 then
                            local timeToReach = math.min(d / math.max(h.WalkSpeed, 16), 1.0)
                            predictTarget = pos + vel * timeToReach * 0.7
                        end
                        Pathfinding.MoveTo(predictTarget, dt, facePos)
                    end
                    tryAttack(0)
                end
            else
                if d <= Config.AttackRange then Pathfinding.StopAndFace(facePos); tryAttack(0)
                else Pathfinding.MoveTo(pos, dt, facePos) end
            end
        end
    end
end

