-- 10. TỰ ĐỘNG BÁN ĐỒ (AUTO SELL)
-- ====================================================================
local AutoSell = {}
local LastSellCheck = 0

function AutoSell.Update()
    if not Config.AutoSell then return end
    if tick() - LastSellCheck < 15 then return end
    LastSellCheck = tick()

    local sellRemote = Remotes:FindFirstChild("sellItem") or Remotes:FindFirstChild("sellItems")
    if not sellRemote then return end

    local inv = LocalPlayer:FindFirstChild("inventory")
    if not inv then return end

    pcall(function()
        for _, item in ipairs(inv:GetChildren()) do
            local rarity = item:FindFirstChild("Rarity") or item:FindFirstChild("rarity")
            if rarity and (rarity.Value == "Common" or rarity.Value == "Uncommon" or rarity.Value == "Rare") then
                local equipped = item:FindFirstChild("Equipped") or item:FindFirstChild("equipped")
                if not (equipped and equipped.Value == true) then
                    sellRemote:FireServer(item)
                    task.wait(0.1)
                end
            end
        end
    end)
end

