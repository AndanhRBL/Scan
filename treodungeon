local AutoFarm = {}
local CurrentTarget = nil
local LastTargetSearch = 0
local LastWeaponAttack = 0
local LastMoveAction = 0

function AutoFarm.Update(dt)
    if not Config.AutoFarm then return end
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    Smooth.DisableAutoRotate(h)

    if Config.EnableAirControl and State.IsJumping then
        local targetPos = CurrentTarget and getPos(CurrentTarget)
        if targetPos then Pathfinding.AirControl(hrp, targetPos) end
        if h.FloorMaterial ~= Enum.Material.Air then State.IsJumping = false end
    end

    if State.StuckTime > Config.StuckDropTargetTime then
        CurrentTarget = nil; _G.CurrentTarget = nil
        State.StuckTime = 0
        Pathfinding.Reset()
    end

    if State.StuckTime > 3 and tick() - LastTargetSearch > 2 then
        AutoTarget.ForceRescan()
        State.StuckTime = 0
        LastTargetSearch = tick() - Config.TargetSearchInterval
    end

    if tick() - LastTargetSearch > Config.TargetSearchInterval then
        if CurrentTarget then
            local hp = getHP(CurrentTarget)
            if not CurrentTarget.Parent or hp <= 0 then
                CurrentTarget = nil; _G.CurrentTarget = nil
                State.KillCount = State.KillCount + 1
                Pathfinding.Stop()
                Obstacle.ClearWaypoints()
                Kiting.Reset()
            end
        end

        if not CurrentTarget then
            CurrentTarget = AutoTarget.GetBestEnemy()
            _G.CurrentTarget = CurrentTarget
            if CurrentTarget then
                Obstacle.ClearWaypoints()
                Kiting.Reset()
                Pathfinding.Reset()
            else
                if Config.AutoOpenChest then
                    local chest = AutoTarget.FindNearestChest()
                    if chest then
                        local pos = chest:IsA("BasePart") and chest.Position or getPos(chest)
                        if pos then
                            local d = (pos - hrp.Position).Magnitude
                            if d <= 10 then
                                local prompt = chest:FindFirstChildOfClass("ProximityPrompt", true)
                                if prompt then
                                    pcall(function()
                                        prompt:InputHoldBegin()
                                        task.wait(prompt.HoldDuration or 0.5)
                                        prompt:InputHoldEnd()
                                    end)
                                end
                            elseif d <= 150 then
                                Pathfinding.MoveTo(pos, dt, pos)
                            end
                        end
                    end
                end
                if Config.AutoClearRoom then
                    local portal = AutoTarget.FindNearestPortal()
                    if portal then
                        local pos = portal:IsA("BasePart") and portal.Position or getPos(portal)
                        if pos then
                            local d = (pos - hrp.Position).Magnitude
                            if d <= 5 then
                                h:MoveTo(hrp.Position)
                            elseif d <= 250 then
                                Pathfinding.MoveTo(pos, dt, pos)
                            end
                        end
                    end
                end
            end
        end
        LastTargetSearch = tick()
    end

    if CurrentTarget and CurrentTarget.Parent then
        local pos = getPos(CurrentTarget)
        if pos then
            local d = (pos - hrp.Position).Magnitude
            local facePos = Vector3.new(pos.X, hrp.Position.Y, pos.Z)

            local function tryAttack(rangeBonus)
                rangeBonus = rangeBonus or 0
                if d <= Config.AttackRange + rangeBonus and Config.AutoAttack
                   and tick() - LastWeaponAttack >= Config.AttackCooldown then
                    local tool = c:FindFirstChildOfClass("Tool")
                    if tool then
                        pcall(function() tool:Activate() end)
                        LastWeaponAttack = tick()
                    end
                end
            end

            -- Kiting xử lý CẢ boss và quái như nhau
            if Config.EnableKiting then
                local kitePos, kiteAction = Kiting.GetKitePosition(hrp, pos, CurrentTarget, dt)

                if kiteAction == "retreat" and kitePos then
                    Pathfinding.MoveTo(kitePos, dt, facePos)
                    tryAttack(5)
                elseif kiteAction == "circle" and kitePos then
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        Pathfinding.MoveTo(kitePos, dt, facePos)
                    end
                    tryAttack(8)
                elseif kiteAction == "attack" then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(0)
                elseif kiteAction == "hold" then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(0)
                elseif kiteAction == "approach" then
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        local predictTarget = pos
                        if Config.PredictMovement then
                            local vel = getVelocity(CurrentTarget)
                            if vel.Magnitude > 1 then
                                local timeToReach = math.min(d / math.max(h.WalkSpeed, 16), 1.0)
                                predictTarget = pos + vel * timeToReach * 0.7
                            end
                        end
                        Pathfinding.MoveTo(predictTarget, dt, facePos)
                    end
                    tryAttack(0)
                end
            else
                if d <= Config.AttackRange then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(0)
                else
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        Pathfinding.MoveTo(pos, dt, facePos)
                    end
                end
            end
        end
    end
end

