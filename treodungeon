local function collectDungeonData()
    local t = {}
    local dungeonName = workspace:FindFirstChild("dungeonName")
    if dungeonName and dungeonName:IsA("StringValue") then t.dungeonName = dungeonName.Value end
    local dungeonProgress = workspace:FindFirstChild("dungeonProgress")
    if dungeonProgress and dungeonProgress:IsA("StringValue") then t.dungeonProgress = dungeonProgress.Value end
    local dungeonStarted = workspace:FindFirstChild("dungeonStarted")
    if dungeonStarted and dungeonStarted:IsA("BoolValue") then t.dungeonStarted = dungeonStarted.Value end
    local hardcore = workspace:FindFirstChild("hardcore")
    if hardcore and hardcore:IsA("BoolValue") then t.hardcore = hardcore.Value; t.isHardcore = hardcore.Value end
    local dungeon = workspace:FindFirstChild("dungeon")
    if dungeon then
        for _, v in ipairs(dungeon:GetChildren()) do if v:IsA("ValueBase") then t[v.Name] = v.Value end end
        local bossRoom = dungeon:FindFirstChild("bossRoom")
        if bossRoom then for _, v in ipairs(bossRoom:GetChildren()) do if v:IsA("ValueBase") then t[v.Name] = v.Value end end end
    end
    return t
end
local isReplaying = false
local function triggerReplayOrLobby()
    if isReplaying then return end
    isReplaying = true
    task.wait(3.5)
    Config.ReplayCount = (Config.ReplayCount or 0) + 1
    if Config.AutoReplay then
        local remotes = ReplicatedStorage:FindFirstChild("remotes")
        local replayRemote = remotes and remotes:FindFirstChild("replayDungeon")
        if replayRemote then
            local data = collectDungeonData()
            pcall(function() replayRemote:FireServer(data) end)
            task.wait(5)
            isReplaying = false
            return
        end
    end
    if Config.AutoBackToLobby then
        local remotes = ReplicatedStorage:FindFirstChild("remotes")
        local lobbyRemote = remotes and (remotes:FindFirstChild("teleportToLobby") or remotes:FindFirstChild("returnToLobby"))
        if lobbyRemote then
            pcall(function() lobbyRemote:FireServer() end)
        else
            TeleportService:Teleport(2414851778, LocalPlayer)
        end
    end
    task.wait(5)
    isReplaying = false
end
