local BossDetect = {}
local BossKeywords = { "boss", "king", "lord", "dragon", "titan", "emperor", "queen", "guardian", "overlord", "demon" }
function BossDetect.IsBoss(enemy)
    if not enemy or not enemy.Parent then return false end
    if enemy:GetAttribute("IsBoss") == true then return true end
    local n = enemy.Name:lower()
    for _, kw in pairs(BossKeywords) do
        if n:find(kw) then return true end
    end
    local ev = enemy:FindFirstChild("EnemyValues")
    if ev and ev:FindFirstChild("IsBoss") and ev.IsBoss.Value == true then return true end
    local h = enemy:FindFirstChildOfClass("Humanoid")
    if h and h.MaxHealth >= 50000 then return true end
    local m = enemy:FindFirstChild("IsBoss")
    if m and m:IsA("BoolValue") and m.Value then return true end
    return false
end
