end

local function selectBestDungeon()
    if not Config.AutoSelectDungeon then return end
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if not ls then return end
    local L = ls:FindFirstChild("Level")
    if not L then return end
    local lvl = L.Value
    if lvl >= 190 then Config.SelectedDungeon, Config.SelectedDifficulty = "Northern Lands", "Nightmare"
    elseif lvl >= 175 then Config.SelectedDungeon, Config.SelectedDifficulty = "Orbital Outpost", "Nightmare"
    elseif lvl >= 160 then Config.SelectedDungeon, Config.SelectedDifficulty = "Steampunk Sewers", "Nightmare"
    elseif lvl >= 145 then Config.SelectedDungeon, Config.SelectedDifficulty = "Ghastly Harbor", "Nightmare"
    elseif lvl >= 130 then Config.SelectedDungeon, Config.SelectedDifficulty = "The Canals", "Nightmare"
    elseif lvl >= 110 then Config.SelectedDungeon, Config.SelectedDifficulty = "Samurai Palace", "Nightmare"
    elseif lvl >= 90 then Config.SelectedDungeon, Config.SelectedDifficulty = "The Underworld", "Insane"
    elseif lvl >= 65 then Config.SelectedDungeon, Config.SelectedDifficulty = "King's Castle", "Hard"
    elseif lvl >= 40 then Config.SelectedDungeon, Config.SelectedDifficulty = "Pirate Island", "Hard"
    elseif lvl >= 20 then Config.SelectedDungeon, Config.SelectedDifficulty = "Winter Outpost", "Medium"
