-- AUTO START
-- =====================================================
local AutoStart = {}
local LastStartAction = 0
local LastStartCheck = 0

local function getDungeonState()
    local g = LocalPlayer:FindFirstChild("PlayerGui")
    if not g then return "unknown" end
    if g:FindFirstChild("countDownGui") then return "starting" end
    if g:FindFirstChild("timeLeftGui") then return "in_dungeon" end
    if g:FindFirstChild("completeGui") then return "completed" end
    if g:FindFirstChild("failedGui") then return "failed" end
    return "lobby"
end

local function selectBestDungeon()
    if not Config.AutoSelectDungeon then return end
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if not ls then return end
    local L = ls:FindFirstChild("Level")
    if not L then return end
    local lvl = L.Value
    if lvl >= 150 then
        Config.SelectedDungeon, Config.SelectedDifficulty = "Northern Lands", "Nightmare"
    elseif lvl >= 100 then
        Config.SelectedDungeon, Config.SelectedDifficulty = "The Underworld", "Insane"
    elseif lvl >= 70 then
        Config.SelectedDungeon, Config.SelectedDifficulty = "Steampunk Sewers", "Hard"
    elseif lvl >= 50 then
        Config.SelectedDungeon, Config.SelectedDifficulty = "The Canals", "Medium"
    elseif lvl >= 30 then
        Config.SelectedDungeon, Config.SelectedDifficulty = "Pirate Island", "Easy"
    else
        Config.SelectedDungeon, Config.SelectedDifficulty = "Desert Temple", "Easy"
    end
end

local function fireChangeStartValue()
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    if not remotes then return false end
    local cs = remotes:FindFirstChild("changeStartValue")
    if not cs then return false end
    pcall(function() cs:FireServer() end)
    return true
end

local function findStartButton()
    local ws = workspace:FindFirstChild("start")
    if ws then
        for _, obj in pairs(ws:GetDescendants()) do
            if obj:IsA("TextButton") then return obj end
        end
    end
    local g = LocalPlayer:FindFirstChild("PlayerGui")
    if g then
        local sb = g:FindFirstChild("startButton")
        if sb then
            for _, obj in pairs(sb:GetDescendants()) do
                if obj:IsA("TextButton") then return obj end
            end
        end
    end
    return nil
end

function AutoStart.Update(dt)
    if not Config.AutoStart then return end
    if tick() - LastStartCheck < 1 then return end
    LastStartCheck = tick()
    if tick() - LastStartAction < 3 then return end
    if getDungeonState() == "lobby" then
        selectBestDungeon()
        if fireChangeStartValue() then
            LastStartAction = tick()
            return
        end
        local btn = findStartButton()
        if btn then
            pcall(function() btn.MouseButton1Down:Fire() end)
            pcall(function() btn.MouseButton1Click:Fire() end)
            LastStartAction = tick()
        end
    end
end

AutoStart.Initialize = function()
    LastStartAction = 0
    LastStartCheck = 0
    print("[AutoStart] OK")
end

-- =====================================================
-- OBSTACLE
-- =====================================================
local Obstacle = {}

local function getRayParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.IgnoreWater = true
    return params
end

local function castRay(origin, direction, distance)
    if distance <= 0 then return nil end
    local params = getRayParams()
    return workspace:Raycast(origin, direction.Unit * distance, params)
end

function Obstacle.CanWalkStraight(hrp, targetPos)
    local origin = hrp.Position + Vector3.new(0, 2, 0)
    local toTarget = targetPos - hrp.Position
    toTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
    local dist = toTarget.Magnitude
    if dist < 1 then return true end
    return castRay(origin, toTarget.Unit, dist) == nil
end

local function wallDistance(hrp, dir, maxDist)
    local origin = hrp.Position + Vector3.new(0, 2, 0)
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.01 then return maxDist end
    local hit = castRay(origin, dir.Unit, maxDist)
    if hit then return hit.Distance end
    return maxDist
end

function Obstacle.IsSpotClear(hrp, targetPos, minWallDist)
    minWallDist = minWallDist or Config.RetreatMinWallDist
    local myPos = hrp.Position
    local toTarget = targetPos - myPos
    toTarget = Vector3.new(toTarget.X, 0, toTarget.Z)
    local dist = toTarget.Magnitude
    if dist < 1 then return true end
    local hit = castRay(myPos + Vector3.new(0, 2, 0), toTarget.Unit, dist)
    if hit and hit.Distance < dist * 0.85 then return false end
    local checkDirs = {Vector3.new(1,0,0), Vector3.new(-1,0,0), Vector3.new(0,0,1), Vector3.new(0,0,-1)}
    for _, d in pairs(checkDirs) do
        if wallDistance(hrp, d, minWallDist) < minWallDist * 0.6 then
            local origin = Vector3.new(targetPos.X, hrp.Position.Y + 2, targetPos.Z)
            local wh = workspace:Raycast(origin, d * minWallDist, getRayParams())
            if wh and wh.Distance < minWallDist * 0.7 then return false end
        end
    end
    return true
end

-- Tìm hướng lùi KHÔNG đâm vào tường
function Obstacle.FindSafeRetreatDir(hrp, dangerPos, minWallDist)
    minWallDist = minWallDist or Config.RetreatMinWallDist
    local myPos = hrp.Position
    local awayDir = myPos - dangerPos
    awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
    if awayDir.Magnitude < 0.1 then
        awayDir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5)
    end
    awayDir = awayDir.Unit
    local baseAngle = math.atan2(awayDir.Z, awayDir.X)
    local n = math.max(Config.RetreatSampleAngles, 8)
    local bestDir, bestScore = awayDir, -math.huge
    for i = 0, n - 1 do
        local angle = baseAngle + (i / n) * math.pi * 2
        local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
        local wd = wallDistance(hrp, dir, 20)
        local dot = dir:Dot(awayDir)
        local score = wd + dot * 8.0
        if score > bestScore then bestScore = score; bestDir = dir end
    end
    return bestDir
end

function Obstacle.AddWaypoint(pos)
    local last = State.Waypoints[#State.Waypoints]
    if last and (pos - last).Magnitude < Config.WaypointMinDistance then return end
    table.insert(State.Waypoints, pos)
    if #State.Waypoints > Config.WaypointHistorySize then
        table.remove(State.Waypoints, 1)
    end
end

function Obstacle.IsLooping(currentPos)
    if #State.Waypoints < 4 then return false end
    for i = 1, #State.Waypoints - 2 do
        if (currentPos - State.Waypoints[i]).Magnitude < Config.WaypointMinDistance then
            return true
        end
    end
    return false
end

function Obstacle.ClearWaypoints() State.Waypoints = {} end
Obstacle.Initialize = function() print("[Obstacle] OK") end

-- =====================================================
-- PATHFINDING (BodyGyro + MoveTo)
-- =====================================================
local Pathfinding = {}
local LastPathCompute = 0
local LastPathTarget = nil
local CurrentPath = nil
local CurrentWaypointIndex = 1
local LastUnstickTime = 0

local function computePath(fromPos, toPos)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2, AgentHeight = 5,
        AgentCanJump = true, AgentCanClimb = false, WaypointSpacing = 4,
    })
    local ok = pcall(function() path:ComputeAsync(fromPos, toPos) end)
    if ok and path.Status == Enum.PathStatus.Success then return path end
    return nil
end

local function checkStuck(hrp)
    local moved = (hrp.Position - State.LastPos).Magnitude
    if moved < 0.3 then
        State.StuckTime = State.StuckTime + 0.05
    else
        State.StuckTime = 0
    end
    State.LastPos = hrp.Position
    return State.StuckTime > Config.StuckThreshold
end

local function unstick(hrp, h)
    local now = tick()
    if now - LastUnstickTime < Config.UnstickCooldown then return end
    LastUnstickTime = now
    h.Jump = true
    local a = math.random() * math.pi * 2
    h:MoveTo(hrp.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * 15)
    State.StuckTime = 0
    CurrentPath = nil
    LastPathTarget = nil
end

function Pathfinding.MoveTo(targetPos, dt, facePos)
    local c = LocalPlayer.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not h or not hrp or h.Health <= 0 then return false end

    Smooth.DisableAutoRotate(h)
    if facePos then Smooth.FaceTarget(hrp, facePos) end

    if checkStuck(hrp) then unstick(hrp, h); return false end
    Obstacle.AddWaypoint(hrp.Position)
    if Obstacle.IsLooping(hrp.Position) then
        Obstacle.ClearWaypoints()
        CurrentPath = nil
        unstick(hrp, h)
        return false
    end

    if not Config.EnableObstacleAvoid then
        h:MoveTo(targetPos)
        return true
    end

    if Obstacle.CanWalkStraight(hrp, targetPos) then
        h:MoveTo(targetPos)
        CurrentPath = nil
        LastPathTarget = nil
        return true
    end

    local needRecompute = false
    if not CurrentPath then needRecompute = true
    elseif not LastPathTarget or (LastPathTarget - targetPos).Magnitude > 5 then needRecompute = true
    elseif tick() - LastPathCompute > Config.PathRecalcInterval then needRecompute = true
    end

    if needRecompute then
        CurrentPath = computePath(hrp.Position, targetPos)
        LastPathCompute = tick()
        LastPathTarget = targetPos
        CurrentWaypointIndex = 1
    end

    if CurrentPath then
        local wps = CurrentPath:GetWaypoints()
        if CurrentWaypointIndex <= #wps then
            local wp = wps[CurrentWaypointIndex]
            if (hrp.Position - wp.Position).Magnitude < 4 then
                CurrentWaypointIndex = CurrentWaypointIndex + 1
                if CurrentWaypointIndex <= #wps then wp = wps[CurrentWaypointIndex] end
            end
            if wp.Action == Enum.PathWaypointAction.Jump then h.Jump = true end
            h:MoveTo(wp.Position)
            return true
        end
    end
    h:MoveTo(targetPos)
    return true
end

function Pathfinding.StopAndFace(facePos)
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not h or not hrp then return end
    h:MoveTo(hrp.Position)
    if facePos then Smooth.FaceTarget(hrp, facePos) end
end

function Pathfinding.AirControl(hrp, targetPos)
    if not Config.EnableAirControl or not State.IsJumping then return end
    local vel = hrp.AssemblyLinearVelocity
    if vel.Y < -5 then
        local toT = targetPos - hrp.Position
        if toT.Magnitude > 2 then
            local dir = toT.Unit
            hrp.AssemblyLinearVelocity = Vector3.new(dir.X * 20, vel.Y, dir.Z * 20)
        end
    end
end

function Pathfinding.Stop()
    local c = LocalPlayer.Character
    if c then
        local h = c:FindFirstChildOfClass("Humanoid")
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if h and hrp then h:MoveTo(hrp.Position) end
    end
    CurrentPath = nil
    LastPathTarget = nil
end

function Pathfinding.Reset()
    CurrentPath = nil
    LastPathTarget = nil
    CurrentWaypointIndex = 1
    State.StuckTime = 0
    Obstacle.ClearWaypoints()
end

Pathfinding.Initialize = function()
    CurrentPath = nil
    LastPathTarget = nil
    CurrentWaypointIndex = 1
    LastUnstickTime = 0
    State.StuckTime = 0
    print("[Pathfinding] OK (V35)")
end

-- =====================================================
-- KITING V35 - BOSS = QUÁI THƯỜNG (chỉ khác khoảng cách)
-- =====================================================
local Kiting = {}
local TargetTypeCache = {}

local function isPathClear(hrp, targetPos)
    local params = getRayParams()
    local origin = hrp.Position + Vector3.new(0, 2, 0)
    local dir = targetPos - hrp.Position
    local dist = dir.Magnitude
    if dist < 1 then return true end
    dir = Vector3.new(dir.X, 0, dir.Z).Unit
    local hit = workspace:Raycast(origin, dir * dist, params)
    return not hit or hit.Distance > dist * 0.85
end

local function safeOrbitPos(hrp, targetPos, idealRadius, strafeDir)
    local myPos = hrp.Position
    local toMe = myPos - targetPos
    toMe = Vector3.new(toMe.X, 0, toMe.Z)
    if toMe.Magnitude < 0.1 then toMe = Vector3.new(1, 0, 0) end
    toMe = toMe.Unit
    local baseAngle = math.atan2(toMe.Z, toMe.X)
    local offsets = {0, 0.35, -0.35, 0.7, -0.7, 1.05, -1.05, 1.4, -1.4, 1.8, -1.8, 2.2, -2.2, 2.7, -2.7, 3.14}
    for _, offset in pairs(offsets) do
        local angle = baseAngle + offset * strafeDir
        local cx = targetPos.X + math.cos(angle) * idealRadius
        local cz = targetPos.Z + math.sin(angle) * idealRadius
        local cand = Vector3.new(cx, myPos.Y, cz)
        if isPathClear(hrp, cand) and Obstacle.IsSpotClear(hrp, cand, 5) then
            return cand
        end
    end
    return nil
end

local function checkTargetType(target)
    if not target then return "normal" end
    local cached = TargetTypeCache[target]
    if cached then return cached end
    local t = "normal"
    if BossDetect.IsBoss(target) then
        t = "boss"
    else
        local name = target.Name:lower()
        if name:find("archer") or name:find("mage") or name:find("wizard")
           or name:find("ranger") or name:find("turret") or name:find("cannon")
           or name:find("sniper") or name:find("gunner") or name:find("shooter") then
            t = "ranged"
        end
    end
    TargetTypeCache[target] = t
    return t
end

-- Khoảng cách mong muốn: boss xa hơn 4 studs, ranged xa hơn 8 studs
function Kiting.GetIdealDistance(target)
    local t = checkTargetType(target)
    if t == "boss" then return Config.KiteDistanceBoss end
    if t == "ranged" then return Config.KiteDistanceRanged end
    return Config.KiteDistance
end

-- Phát hiện enemy đang attack/cast (dùng chung cho CẢ boss và quái)
local function isEnemyCastingOrAttacking(enemy)
    if not enemy or not enemy.Parent then return false end
    local h = enemy:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    local anim = h:FindFirstChildOfClass("Animator")
    if not anim then return false end
    for _, track in pairs(anim:GetPlayingAnimationTracks()) do
        if not track.Looped and track.Animation then
            local aname = (track.Animation.Name or ""):lower()
            -- Cả attack và telegraph đều coi là "sắp ra chiêu"
            if isKeywordMatch(aname, {
                "attack", "punch", "slash", "shoot", "beam", "spell",
                "skill", "smash", "swing", "strike", "combo", "slam",
                "stomp", "cast", "windup", "charge", "prepare", "warning",
                "telegraph", "channel", "ultimate", "bossattack",
            }) then
                return true
            end
        end
    end
    return false
end

-- LOGIC CHÍNH: boss và quái đi cùng 1 đường
function Kiting.GetKitePosition(hrp, targetPos, targetObj, dt)
    if not Config.EnableKiting then return nil end
    local myPos = hrp.Position
    local toTarget = targetPos - myPos
    local dist = toTarget.Magnitude
    if dist < 0.1 then return nil end

    local idealDist = Kiting.GetIdealDistance(targetObj)
    local isCasting = isEnemyCastingOrAttacking(targetObj)

    -- ==== 1. QUÁ GẦN → RETREAT ====
    if dist < Config.KiteDistanceMin then
        local safeDir = Obstacle.FindSafeRetreatDir(hrp, targetPos, Config.RetreatMinWallDist)
        local extra = isCasting and Config.AttackRetreatExtra or 0
        local retreatDist = (Config.KiteDistanceMin - dist) + Config.RetreatExtra + extra
        local retreatPos = myPos + safeDir * retreatDist
        if Obstacle.IsSpotClear(hrp, retreatPos, Config.RetreatMinWallDist) then
            return retreatPos, "retreat"
        end
        local rightDir = Vector3.new(-safeDir.Z, 0, safeDir.X)
        for _, sign in pairs({1, -1}) do
            local sidePos = myPos + rightDir * sign * retreatDist
            if Obstacle.IsSpotClear(hrp, sidePos, Config.RetreatMinWallDist) then
                return sidePos, "retreat"
            end
        end
        return retreatPos, "retreat"
    end

    -- ==== 2. ENEMY ĐANG CAST/ATTACK → RETREAT THÊM ====
    -- Dù đang trong khoảng lý tưởng, nếu enemy cast → lùi ngay
    if isCasting and dist < idealDist + 4 then
        local safeDir = Obstacle.FindSafeRetreatDir(hrp, targetPos, Config.RetreatMinWallDist)
        local retreatDist = Config.AttackRetreatExtra + 4
        local retreatPos = myPos + safeDir * retreatDist
        if Obstacle.IsSpotClear(hrp, retreatPos, Config.RetreatMinWallDist) then
            return retreatPos, "retreat"
        end
        local rightDir = Vector3.new(-safeDir.Z, 0, safeDir.X)
        for _, sign in pairs({1, -1}) do
            local sidePos = myPos + rightDir * sign * retreatDist
            if Obstacle.IsSpotClear(hrp, sidePos, Config.RetreatMinWallDist) then
                return sidePos, "retreat"
            end
        end
        return retreatPos, "retreat"
    end

    -- ==== 3. TRONG KHOẢNG LÝ TƯỞNG → CIRCLE STRAFE ====
    if dist >= Config.KiteDistanceMin and dist <= idealDist + 5 then
        if Config.EnableCircleStrafe then
            if tick() - State.LastCircleFlip > 2.5 then
                State.CircleStrafeDir = -State.CircleStrafeDir
                State.LastCircleFlip = tick()
            end
            local strafeMultiplier = isCasting and 1.3 or 1.0
            local orbitRadius = idealDist
            local safePos = safeOrbitPos(hrp, targetPos, orbitRadius, State.CircleStrafeDir)
            if safePos then
                local rightDir = hrp.CFrame.RightVector
                local strafeOffset = rightDir * (Config.StrafeDistance * State.CircleStrafeDir
                                                 * Config.CircleStrafeSpeed * strafeMultiplier)
                return safePos + strafeOffset, "circle"
            end
            if dist > Config.AttackRange * 0.9 then return targetPos, "approach" end
            return nil, "attack"
        end
        if dist > Config.AttackRange * 0.9 then return targetPos, "approach" end
        return nil, "attack"
    end

    -- ==== 4. XA QUÁ → APPROACH ====
    if dist > idealDist + 5 and dist <= Config.KiteDistanceMax then
        return targetPos, "approach"
    end
    if dist > Config.KiteDistanceMax then
        return targetPos, "approach"
    end
    return nil, "hold"
end

function Kiting.Reset()
    State.CircleStrafeDir = 1
    State.LastCircleFlip = 0
    TargetTypeCache = {}
end

