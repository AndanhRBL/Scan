    if not Config.AutoSkill then return end
    if tick() - LastSkillTime < Config.SkillDelay then return end
    if not State.Target or not isTargetValid(State.Target) then return end

    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = getRoot(myChar)
    local tRoot = getRoot(State.Target)
    if not myRoot or not tRoot then return end

    local dist = (tRoot.Position - myRoot.Position).Magnitude
    if dist <= Config.AttackRange + 8 then
        for _, key in ipairs(Config.SkillPriority) do
            AutoSkill.Cast(key)
            LastSkillTime = tick()
            break
        end
    end
end

