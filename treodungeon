function Visualize.Clear()
    for _, p in pairs(VisualizeParts) do
        if p and p.Parent then p:Destroy() end
    end
    VisualizeParts = {}
end

function Visualize.DrawSphere(pos, radius, color)
    local part = Instance.new("Part")
    part.Anchored = true; part.CanCollide = false
    part.Material = Enum.Material.Neon; part.Color = color
    part.Shape = Enum.PartType.Ball
    part.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
    part.CFrame = CFrame.new(pos); part.Transparency = 0.7
    part.Parent = workspace
    table.insert(VisualizeParts, part)
    task.delay(0.15, function() if part and part.Parent then part:Destroy() end end)
end

function Visualize.Update()
    if not VisualizeEnabled then return end
    local c = LocalPlayer.Character
    if not c then return end
    if _G.CurrentTarget and _G.CurrentTarget.Parent then
        local targetPos = getPos(_G.CurrentTarget)
        if targetPos then
            local idealDist = Kiting.GetIdealDistance(_G.CurrentTarget)
            if idealDist > 0 then
                Visualize.DrawSphere(targetPos, idealDist, Color3.fromRGB(0, 100, 255))
            end
        end
    end
end

function Visualize.Toggle()
    VisualizeEnabled = not VisualizeEnabled
    if not VisualizeEnabled then Visualize.Clear() end
