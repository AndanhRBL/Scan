local AutoSkill = {}
local LastCast = 0
local SkillIdx = 1
local function findToolByName(name)
    for _, cont in pairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
        if cont then
            for _, t in pairs(cont:GetChildren()) do
                if t:IsA("Tool") and t.Name == name then return t end
            end
        end
    end
    return nil
end
local function findSlot(slot)
    for _, cont in pairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
        if cont then
            for _, t in pairs(cont:GetChildren()) do
                if t:IsA("Tool") then
                    local a = t:FindFirstChild("abilitySlot")
                    if a and tostring(a.Value):lower() == tostring(slot):lower() then return t end
                end
            end
        end
    end
    return nil
end
local function castTool(tool, slotName)
    if not tool then return false end
    local cd = tool:FindFirstChild("cooldown")
    if cd and cd.Value > 0 then return false end
    local slot = slotName or (tool:FindFirstChild("abilitySlot") and tostring(tool.abilitySlot.Value):lower()) or "q"
    local casted = false
    -- 1. Client Event (VFX, sound & client projectile)
    local le = tool:FindFirstChild("localEvent")
    if le then
        pcall(function() le:Fire() end)
        casted = true
    end
    -- 2. Server Event: abilityUsed (CRITICAL - DEALS DAMAGE & SERVER CAST)
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    if remotes and remotes:FindFirstChild("abilityUsed") then
        pcall(function() remotes.abilityUsed:FireServer(slot, tool) end)
        casted = true
    end
    -- 3. Tool internal RemoteEvents
    for _, rn in pairs({"spellEvent", "abilityEvent", "fireballShootEvent"}) do
        local r = tool:FindFirstChild(rn)
        if r then
            pcall(function() r:FireServer() end)
            casted = true
        end
    end
    -- 4. VirtualInputManager keypress (direct UIS.lua trigger)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        if vim then
            local key = (slot == "e" or slot == "e2") and Enum.KeyCode.E or Enum.KeyCode.Q
            vim:SendKeyEvent(true, key, false, game)
            task.wait(0.01)
            vim:SendKeyEvent(false, key, false, game)
        end
    end)
    return casted
end
local function getNextSkill()
    local priority = Config.SkillPriority
    if not priority or #priority == 0 then priority = {"q", "e", "q2", "e2"} end
    for i = 1, #priority do
        local idx = ((SkillIdx + i - 2) % #priority) + 1
        local nameOrSlot = priority[idx]
        local t = findSlot(nameOrSlot) or findToolByName(nameOrSlot)
        if t then
            local cd = t:FindFirstChild("cooldown")
            if cd and cd.Value <= 0 then
                SkillIdx = idx
                local sName = (t:FindFirstChild("abilitySlot") and tostring(t.abilitySlot.Value):lower()) or tostring(nameOrSlot):lower()
                return t, sName
            end
        end
    end
    return nil, nil
end
function AutoSkill.Update(dt)
    if not Config.AutoSkill then return end
    if tick() - LastCast < Config.SkillDelay then return end
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return end
    local bc = c:FindFirstChild("busyCasting")
    if bc and bc.Value == true then return end
    local target = _G.CurrentTarget or (AutoTarget and AutoTarget.GetBestEnemy())
    if not target or not target.Parent then return end
    local targetPos = getPos(target)
    if targetPos then
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if hrp and (targetPos - hrp.Position).Magnitude > Config.FarmRange then
            return
        end
    end
    local t, slotName = getNextSkill()
    if t and castTool(t, slotName) then
        LastCast = tick()
    end
end
