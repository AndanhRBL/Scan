-- =====================================================
local AutoStart = {}
local LastStartAction = 0
local LastStartCheck = 0

local function getDungeonState()
    local g = LocalPlayer:FindFirstChild("PlayerGui")
    if not g then return "unknown" end
    if g:FindFirstChild("countDownGui") then return "starting" end
    if g:FindFirstChild("timeLeftGui") then return "in_dungeon" end
    if g:FindFirstChild("completeGui") then return "completed" end
    if g:FindFirstChild("failedGui") then return "failed" end
    if isLobby() then return "lobby" end
    return "waiting_start"
end

local function fireChangeStartValue()
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    if not remotes then return false end
    local cs = remotes:FindFirstChild("changeStartValue")
    local ru = remotes:FindFirstChild("readyUp")
    if cs then pcall(function() cs:FireServer() end) end
    if ru then pcall(function() ru:FireServer() end) end
    return true
end

local function findStartButton()
    local ws = workspace:FindFirstChild("start")
    if ws then
        for _, obj in pairs(ws:GetDescendants()) do
            if obj:IsA("TextButton") then return obj end
        end
    end
    local g = LocalPlayer:FindFirstChild("PlayerGui")
    if g then
        for _, guiName in pairs({"startButton", "readyButton", "countDownGui"}) do
            local sb = g:FindFirstChild(guiName)
            if sb then
                for _, obj in pairs(sb:GetDescendants()) do
                    if obj:IsA("TextButton") then return obj end
                end
            end
        end
    end
    return nil
end

function AutoStart.Update(dt)
    if not Config.AutoStart then return end
    if tick() - LastStartCheck < 0.8 then return end
    LastStartCheck = tick()
    if tick() - LastStartAction < 2.5 then return end

    local dState = getDungeonState()

    if dState == "waiting_start" or dState == "lobby" then
        fireChangeStartValue()
        local btn = findStartButton()
        if btn then
            pcall(function()
                if firesignal then
                    firesignal(btn.MouseButton1Down)
                    firesignal(btn.MouseButton1Click)
                else
                    btn.MouseButton1Down:Fire()
                    btn.MouseButton1Click:Fire()
                end
            end)
            LastStartAction = tick()
            return
        end

        if isLobby() then
            pcall(function()
                local inLobby = false
                if workspace:FindFirstChild("games") then
                    for _, v in pairs(workspace.games.inLobby:GetChildren()) do
                        if v:FindFirstChild(LocalPlayer.Name) then inLobby = true; break end
                    end
                end
                local remotes = ReplicatedStorage:FindFirstChild("remotes")
                local createLobby = remotes and remotes:FindFirstChild("createLobby")
                local startDungeon = remotes and remotes:FindFirstChild("startDungeon")
                if not inLobby and createLobby then
                    createLobby:InvokeServer(
                        Config.SelectedDungeon, Config.SelectedDifficulty, 0,
                        Config.Hardcore, true, false
                    )
                end
                if startDungeon then startDungeon:FireServer() end
                LastStartAction = tick()
            end)
        end
    end
end

AutoStart.Initialize = function()
    LastStartAction = 0
    LastStartCheck = 0
end

-- =====================================================
-- OBSTACLE
-- =====================================================
local Obstacle = {}
local RayParams = nil

local function getRayParams()
    if not RayParams then
        RayParams = RaycastParams.new()
        RayParams.FilterType = Enum.RaycastFilterType.Exclude
        RayParams.IgnoreWater = true
    end
    local ignore = {LocalPlayer.Character}
    for _, item in pairs(Config.RaycastIgnoreList) do
        if item then table.insert(ignore, item) end
    end
    RayParams.FilterDescendantsInstances = ignore
    return RayParams
end

local function castRay(origin, direction, distance)
    if distance <= 0 then return nil end
    return workspace:Raycast(origin, direction.Unit * distance, getRayParams())
end

local function isSafeFloor(pos)
    local char = LocalPlayer.Character
    if not char then return false end
    local hit = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -14, 0), getRayParams())
    return hit ~= nil
end

local function wallDistance(hrp, dir, maxDist)
    local origin = hrp.Position + Vector3.new(0, 2, 0)
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.01 then return maxDist end
    local hit = castRay(origin, dir.Unit, maxDist)
    return hit and hit.Distance or maxDist
end

function Obstacle.IsSpotClear(hrp, targetPos, minWallDist)
    minWallDist = minWallDist or Config.RetreatMinWallDist
    local myPos = hrp.Position
    local toTarget = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
    local dist = toTarget.Magnitude
    if dist < 1 then return true end
    local hit = castRay(myPos + Vector3.new(0, 2, 0), toTarget.Unit, dist)
    if hit and hit.Distance < dist * 0.85 then return false end
    if not isSafeFloor(targetPos) then return false end
    return true
end

function Obstacle.FindSafeRetreatDir(hrp, dangerPos, minWallDist)
    minWallDist = minWallDist or Config.RetreatMinWallDist
    local myPos = hrp.Position
    local awayDir = myPos - dangerPos
    awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
    if awayDir.Magnitude < 0.1 then awayDir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) end
    awayDir = awayDir.Unit
    local baseAngle = math.atan2(awayDir.Z, awayDir.X)
    local n = math.max(Config.RetreatSampleAngles, 8)
    local bestDir, bestScore = awayDir, -math.huge
    for i = 0, n - 1 do
        local angle = baseAngle + (i / n) * math.pi * 2
        local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
        local wd = wallDistance(hrp, dir, 20)
        local safeF = isSafeFloor(myPos + dir * 10) and 10 or -50
        local dot = dir:Dot(awayDir)
        local score = wd + dot * 8.0 + safeF
        if score > bestScore then bestScore = score; bestDir = dir end
    end
    return bestDir
end

function Obstacle.CanWalkStraight(hrp, targetPos)
    local toTarget = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
    local dist = toTarget.Magnitude
    if dist < 1 then return true end
    return castRay(hrp.Position + Vector3.new(0, 2, 0), toTarget.Unit, dist) == nil
end

function Obstacle.AddWaypoint(pos)
    local last = State.Waypoints[#State.Waypoints]
    if last and (pos - last).Magnitude < 4 then return end
    table.insert(State.Waypoints, pos)
    if #State.Waypoints > 10 then table.remove(State.Waypoints, 1) end
end

function Obstacle.IsLooping(currentPos)
    if #State.Waypoints < 4 then return false end
    for i = 1, #State.Waypoints - 2 do
        if (currentPos - State.Waypoints[i]).Magnitude < 4 then return true end
    end
    return false
end

function Obstacle.ClearWaypoints() State.Waypoints = {} end
Obstacle.Initialize = function() State.Waypoints = {} end

-- =====================================================
-- PATHFINDING
-- =====================================================
local Pathfinding = {}
local LastPathCompute = 0
local LastPathTarget = nil
local CurrentPath = nil
local CurrentWaypointIndex = 1
local LastUnstickTime = 0

local function computePath(fromPos, toPos)
    local path = PathfindingService:CreatePath({
        AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, AgentCanClimb = false, WaypointSpacing = 4,
    })
    local ok = pcall(function() path:ComputeAsync(fromPos, toPos) end)
    if ok and path.Status == Enum.PathStatus.Success then return path end
    return nil
end

local function checkStuck(hrp)
    local moved = (hrp.Position - State.LastPos).Magnitude
    if moved < 0.3 then State.StuckTime = State.StuckTime + 0.05
    else State.StuckTime = 0 end
    State.LastPos = hrp.Position
    return State.StuckTime > Config.StuckThreshold
end

local function unstick(hrp, h)
    local now = tick()
    if now - LastUnstickTime < 1.0 then return end
    LastUnstickTime = now
    h.Jump = true
    local a = math.random() * math.pi * 2
    h:MoveTo(hrp.Position + Vector3.new(math.cos(a), 0, math.sin(a)) * 15)
    State.StuckTime = 0
    CurrentPath = nil
    LastPathTarget = nil
end

function Pathfinding.MoveTo(targetPos, dt, facePos)
    local c = LocalPlayer.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not h or not hrp or h.Health <= 0 then return false end

    Smooth.DisableAutoRotate(h)
    if facePos then Smooth.FaceTarget(hrp, facePos) end

    if checkStuck(hrp) then unstick(hrp, h); return false end
    Obstacle.AddWaypoint(hrp.Position)
    if Obstacle.IsLooping(hrp.Position) then
        Obstacle.ClearWaypoints()
        unstick(hrp, h)
        return false
    end

    if Obstacle.CanWalkStraight(hrp, targetPos) then
        h:MoveTo(targetPos)
        CurrentPath = nil
        LastPathTarget = nil
        return true
    end

    local needRecompute = false
    if not CurrentPath or not LastPathTarget or (LastPathTarget - targetPos).Magnitude > 5 or (tick() - LastPathCompute > Config.PathRecalcInterval) then
        needRecompute = true
    end

    if needRecompute then
        CurrentPath = computePath(hrp.Position, targetPos)
        LastPathCompute = tick()
        LastPathTarget = targetPos
        CurrentWaypointIndex = 1
    end

    if CurrentPath then
        local wps = CurrentPath:GetWaypoints()
        if CurrentWaypointIndex <= #wps then
            local wp = wps[CurrentWaypointIndex]
            if (hrp.Position - wp.Position).Magnitude < 4 then
                CurrentWaypointIndex = CurrentWaypointIndex + 1
                if CurrentWaypointIndex <= #wps then wp = wps[CurrentWaypointIndex] end
            end
            if wp.Action == Enum.PathWaypointAction.Jump then h.Jump = true end
            h:MoveTo(wp.Position)
            return true
        end
    end
    h:MoveTo(targetPos)
    return true
end

function Pathfinding.StopAndFace(facePos)
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if h and hrp then
        h:MoveTo(hrp.Position)
        if facePos then Smooth.FaceTarget(hrp, facePos) end
    end
end

function Pathfinding.AirControl(hrp, targetPos)
    if not hrp then return end
    local toTarget = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
    if toTarget.Magnitude < 0.5 then return end
    local currentVel = hrp.AssemblyLinearVelocity
    local currentSpeed = Vector3.new(currentVel.X, 0, currentVel.Z).Magnitude
    local desiredDir = toTarget.Unit
    local targetSpeed = math.max(currentSpeed, Config.WalkSpeed)
    local newHorizontalVel = desiredDir * targetSpeed
    hrp.AssemblyLinearVelocity = Vector3.new(newHorizontalVel.X, currentVel.Y, newHorizontalVel.Z)
end

function Pathfinding.Stop()
    local c = LocalPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if h and hrp then h:MoveTo(hrp.Position) end
    CurrentPath = nil
    LastPathTarget = nil
end

function Pathfinding.Reset()
    CurrentPath = nil
    LastPathTarget = nil
    CurrentWaypointIndex = 1
    State.StuckTime = 0
end

Pathfinding.Initialize = function() Pathfinding.Reset() end

-- =====================================================
-- KITING
-- =====================================================
local Kiting = {}
local TargetTypeCache = {}

local function isEnemyCastingOrAttacking(enemy)
    if not enemy then return false end
    local h = enemy:FindFirstChildOfClass("Humanoid")
    if not h then return false end
    local ok, tracks = pcall(function() return h:GetPlayingAnimationTracks() end)
    if ok and tracks then
        for _, track in pairs(tracks) do
            local aname = (track.Animation.Name or ""):lower()
            if isKeywordMatch(aname, {
                "attack", "punch", "slash", "shoot", "beam", "spell",
                "skill", "smash", "swing", "strike", "combo", "slam",
                "stomp", "cast", "windup", "charge", "prepare", "warning",
            }) then return true end
        end
    end
    return false
end

function Kiting.GetIdealDistance(targetObj)
    if BossDetect.IsBoss(targetObj) then return Config.KiteDistanceBoss end
    return Config.KiteDistance
end

function Kiting.GetKitePosition(hrp, targetPos, targetObj, dt)
    if not Config.EnableKiting then return nil end
    local myPos = hrp.Position
    local toTarget = targetPos - myPos
    local dist = toTarget.Magnitude
    if dist < 0.1 then return nil end

    local idealDist = Kiting.GetIdealDistance(targetObj)
    local isCasting = isEnemyCastingOrAttacking(targetObj)

    if dist < Config.KiteDistanceMin then
        local safeDir = Obstacle.FindSafeRetreatDir(hrp, targetPos, Config.RetreatMinWallDist)
        local extra = isCasting and Config.AttackRetreatExtra or 0
        local retreatDist = (Config.KiteDistanceMin - dist) + Config.RetreatExtra + extra
        local retreatPos = myPos + safeDir * retreatDist
        return retreatPos, "retreat"
    end

    if isCasting and dist < idealDist + 4 then
        local safeDir = Obstacle.FindSafeRetreatDir(hrp, targetPos, Config.RetreatMinWallDist)
        local retreatDist = Config.AttackRetreatExtra + 4
        return myPos + safeDir * retreatDist, "retreat"
    end

    if dist >= Config.KiteDistanceMin and dist <= idealDist + 5 then
        if Config.EnableCircleStrafe then
            if tick() - State.LastCircleFlip > 2.5 then
                State.CircleStrafeDir = -State.CircleStrafeDir
                State.LastCircleFlip = tick()
            end
            local toMe = (myPos - targetPos)
            local baseAngle = math.atan2(toMe.Z, toMe.X)
            local angle = baseAngle + 0.35 * State.CircleStrafeDir
            local cx = targetPos.X + math.cos(angle) * idealDist
            local cz = targetPos.Z + math.sin(angle) * idealDist
            local cand = Vector3.new(cx, myPos.Y, cz)
            if Obstacle.IsSpotClear(hrp, cand, 5) then
                return cand, "circle"
            end
        end
        return nil, "attack"
    end

    if dist > idealDist + 5 then
        return targetPos, "approach"
    end
    return nil, "hold"
end

function Kiting.Reset()
    State.CircleStrafeDir = 1
    State.LastCircleFlip = 0
    TargetTypeCache = {}
end

