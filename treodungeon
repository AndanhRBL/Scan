local Smooth = {}
local currentGyro = nil
function Smooth.FaceTarget(hrp, targetPos)
    if not hrp or not targetPos then return end
    if not currentGyro or currentGyro.Parent ~= hrp then
        if currentGyro then pcall(function() currentGyro:Destroy() end) end
        currentGyro = Instance.new("BodyGyro")
        currentGyro.Name = "AutoFarmFaceGyro"
        currentGyro.MaxTorque = Vector3.new(0, Config.GyroPower, 0)
        currentGyro.P = Config.GyroPower
        currentGyro.D = Config.GyroDamping
        currentGyro.Parent = hrp
    end
    local flatTarget = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
    local dir = (flatTarget - hrp.Position)
    if dir.Magnitude > 0.1 then
        currentGyro.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir.Unit)
    end
end
function Smooth.ClearGyro()
    if currentGyro then
        pcall(function() currentGyro:Destroy() end)
        currentGyro = nil
    end
end
