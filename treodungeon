-- WALKSPEED
-- =====================================================
local WalkSpeed = {}
local LastSpeedSet = 0

function WalkSpeed.Update(dt)
    if tick() - LastSpeedSet < 0.5 then return end
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h and math.abs(h.WalkSpeed - 20) > 0.5 then
        h.WalkSpeed = 20
        LastSpeedSet = tick()
    end
    if h and h.AutoRotate then h.AutoRotate = false end
end

WalkSpeed.Initialize = function() LastSpeedSet = 0 end

