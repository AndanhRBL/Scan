local function scanAllHazards(rootPos)
    local containers = { workspace }
    if workspace:FindFirstChild("enemyProjectiles") then table.insert(containers, workspace.enemyProjectiles) end
    if workspace:FindFirstChild("projectiles") then table.insert(containers, workspace.projectiles) end
    if workspace:FindFirstChild("dungeon") then table.insert(containers, workspace.dungeon) end

    for _, container in ipairs(containers) do
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("BasePart") then
                local isHazard, shape = false, "Circle"
                local name = obj.Name:lower()
                local isRed = (obj.Color.R > 0.65 and obj.Color.G < 0.45)
                local isNeon = (obj.Material == Enum.Material.Neon)
                if name:find("damagearea") or name:find("hitbox") or name:find("telegraph") or name:find("laser") or name:find("beam") or (isNeon and isRed and obj.Anchored) then
                    isHazard = true
                end
                if isHazard then
                    if obj.Size.Z > 14 or obj.Size.X > 14 then shape = "Cube"
                    elseif obj.Shape == Enum.PartType.Cylinder or obj.Shape == Enum.PartType.Ball then shape = "Circle" end
                    local inDanger, escapePos = checkHazardIntersection(rootPos, {
                        shape = shape, cframe = obj.CFrame, position = obj.Position, size = obj.Size, radius = math.max(obj.Size.X, obj.Size.Z) / 2
                    })
                    if inDanger then return true, escapePos end
                end
            elseif obj:IsA("Model") and (obj.Name:lower():find("projectile") or obj.Name:lower():find("spell") or obj.Name:lower():find("orb")) then
                local pPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                if pPart then
                    local dist = (Vector3.new(rootPos.X, 0, rootPos.Z) - Vector3.new(pPart.Position.X, 0, pPart.Position.Z)).Magnitude
                    if dist < 18 and math.abs(rootPos.Y - pPart.Position.Y) < 12 then
                        local dir = (Vector3.new(rootPos.X, 0, rootPos.Z) - Vector3.new(pPart.Position.X, 0, pPart.Position.Z)).Unit
                        return true, pPart.Position + dir * 22
                    end
                end
            end
        end
    end

    local now = os.clock()
    for id, hazard in pairs(activeHazards) do
        if hazard.expires and hazard.expires < now then activeHazards[id] = nil
        else
            local inDanger, escapePos = checkHazardIntersection(rootPos, hazard)
            if inDanger then return true, escapePos end
        end
    end
    return false, nil
end

function Kiting.GetKitePosition(hrp, targetPos, targetObj, dt)
    if not Config.EnableKiting then return nil end
    local myPos = hrp.Position
    local toTarget = targetPos - myPos
    local dist = toTarget.Magnitude
    if dist < 0.1 then return nil end

    local idealDist = Kiting.GetIdealDistance(targetObj)
    local isCasting = isEnemyCastingOrAttacking(targetObj)

    -- 1. Quá gần -> Lùi xa ngay
    if dist < Config.KiteDistanceMin then
        local safeDir = Obstacle.FindSafeRetreatDir(hrp, targetPos, Config.RetreatMinWallDist)
        local extra = isCasting and Config.AttackRetreatExtra or 0
        local retreatDist = (Config.KiteDistanceMin - dist) + Config.RetreatExtra + extra
        local retreatPos = myPos + safeDir * retreatDist
        return retreatPos, "retreat"
    end

    -- 2. Đang ra đòn -> Lùi né tránh
    if isCasting and dist < idealDist + 4 then
        local safeDir = Obstacle.FindSafeRetreatDir(hrp, targetPos, Config.RetreatMinWallDist)
        local retreatDist = Config.AttackRetreatExtra + 4
        return myPos + safeDir * retreatDist, "retreat"
    end

    -- 3. Trong khoảng lý tưởng -> Circle Strafe kiting
    if dist >= Config.KiteDistanceMin and dist <= idealDist + 5 then
        if Config.EnableCircleStrafe then
            if tick() - State.LastCircleFlip > 2.5 then
                State.CircleStrafeDir = -State.CircleStrafeDir
                State.LastCircleFlip = tick()
            end
            local toMe = (myPos - targetPos)
            local baseAngle = math.atan2(toMe.Z, toMe.X)
            local angle = baseAngle + 0.35 * State.CircleStrafeDir
            local cx = targetPos.X + math.cos(angle) * idealDist
            local cz = targetPos.Z + math.sin(angle) * idealDist
            local cand = Vector3.new(cx, myPos.Y, cz)
            if Obstacle.IsSpotClear(hrp, cand, 5) then
                return cand, "circle"
            end
        end
        return nil, "attack"
    end

    -- 4. Quá xa -> Tiếp cận
    if dist > idealDist + 5 then
        return targetPos, "approach"
    end
    return nil, "hold"
end

function Kiting.Reset()
    State.CircleStrafeDir = 1
    State.LastCircleFlip = 0
    TargetTypeCache = {}
end

