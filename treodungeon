-- =====================================================
-- AUTO SKILL
-- =====================================================
local AutoSkill = {}
local LastCast = 0
local SkillIdx = 1

local function findToolByName(name)
    for _, cont in pairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
        if cont then
            for _, t in pairs(cont:GetChildren()) do if t:IsA("Tool") and t.Name == name then return t end end
        end
    end
    return nil
end

local function castTool(tool)
    if not tool then return false end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if tool.Parent ~= char then hum:EquipTool(tool); task.wait(0.02) end
    tool:Activate()
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    if remotes and remotes:FindFirstChild("useSkill") then
        pcall(function() remotes.useSkill:FireServer(tool.Name) end)
    end
    return true
end

local function getNextSkill()
    local keys = Config.SkillPriority
    if #keys == 0 then return nil end
    for i = 1, #keys do
        local idx = ((SkillIdx - 1 + i - 1) % #keys) + 1
        local key = keys[idx]
        local t = findToolByName(key)
        if t then SkillIdx = (idx % #keys) + 1; return t end
    end
    return nil
end

function AutoSkill.Update(dt)
    if not Config.AutoSkill then return end
    if tick() - LastCast < Config.SkillDelay then return end
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return end
    local bc = c:FindFirstChild("busyCasting")
    if bc and bc.Value == true then return end
    local t = getNextSkill()
    if t and castTool(t) then LastCast = tick() end
end

AutoSkill.Initialize = function() LastCast = 0; SkillIdx = 1 end

