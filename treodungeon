-- 6. CẢM BIẾN HỐ & NÉ TƯỜNG (OBSTACLE AVOIDANCE V35)
-- ====================================================================
local Obstacle = {}

local function getRayParams()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.IgnoreWater = true
    return params
end

local function castRay(origin, direction, distance)
    if distance <= 0 then return nil end
    return workspace:Raycast(origin, direction.Unit * distance, getRayParams())
end

local function isSafeFloor(pos)
    local char = LocalPlayer.Character
    if not char then return false end
    local hit = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -14, 0), getRayParams())
    return hit ~= nil
end

local function wallDistance(hrp, dir, maxDist)
    local origin = hrp.Position + Vector3.new(0, 2, 0)
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.01 then return maxDist end
    local hit = castRay(origin, dir.Unit, maxDist)
    return hit and hit.Distance or maxDist
end

function Obstacle.IsSpotClear(hrp, targetPos, minWallDist)
    minWallDist = minWallDist or Config.RetreatMinWallDist
    local myPos = hrp.Position
    local toTarget = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z)
    local dist = toTarget.Magnitude
    if dist < 1 then return true end
    local hit = castRay(myPos + Vector3.new(0, 2, 0), toTarget.Unit, dist)
    if hit and hit.Distance < dist * 0.85 then return false end
    if not isSafeFloor(targetPos) then return false end
    return true
end

function Obstacle.FindSafeRetreatDir(hrp, dangerPos, minWallDist)
    minWallDist = minWallDist or Config.RetreatMinWallDist
    local myPos = hrp.Position
    local awayDir = myPos - dangerPos
    awayDir = Vector3.new(awayDir.X, 0, awayDir.Z)
    if awayDir.Magnitude < 0.1 then awayDir = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) end
    awayDir = awayDir.Unit
    local baseAngle = math.atan2(awayDir.Z, awayDir.X)
    local n = math.max(Config.RetreatSampleAngles, 8)
    local bestDir, bestScore = awayDir, -math.huge
    for i = 0, n - 1 do
        local angle = baseAngle + (i / n) * math.pi * 2
        local dir = Vector3.new(math.cos(angle), 0, math.sin(angle))
        local wd = wallDistance(hrp, dir, 20)
        local safeF = isSafeFloor(myPos + dir * 10) and 10 or -50
        local dot = dir:Dot(awayDir)
        local score = wd + dot * 8.0 + safeF
        if score > bestScore then bestScore = score; bestDir = dir end
    end
    return bestDir
end

function Obstacle.CanWalkStraight(hrp, targetPos)
    local toTarget = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
    local dist = toTarget.Magnitude
    if dist < 1 then return true end
    return castRay(hrp.Position + Vector3.new(0, 2, 0), toTarget.Unit, dist) == nil
end

function Obstacle.AddWaypoint(pos)
    local last = State.Waypoints[#State.Waypoints]
    if last and (pos - last).Magnitude < 4 then return end
    table.insert(State.Waypoints, pos)
    if #State.Waypoints > 10 then table.remove(State.Waypoints, 1) end
end

function Obstacle.IsLooping(currentPos)
    if #State.Waypoints < 4 then return false end
    for i = 1, #State.Waypoints - 2 do
        if (currentPos - State.Waypoints[i]).Magnitude < 4 then return true end
    end
    return false
end

function Obstacle.ClearWaypoints() State.Waypoints = {} end

