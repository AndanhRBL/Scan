local function onInputBegan(input, gpe)
    if gpe then return end
    local k = input.KeyCode
    if k == Config.KeyToggle then UI.Toggle(); return end
    if k == Config.KeyFarm then
        Config.AutoFarm = not Config.AutoFarm
        UI.UpdateStatus("AutoFarm", Config.AutoFarm); return
    end
    if k == Config.KeyDebugAll then AutoTarget.DebugAllHumanoids(); return end
    if k == Config.KeySkill then
        Config.AutoSkill = not Config.AutoSkill
        UI.UpdateStatus("AutoSkill", Config.AutoSkill); return
    end
    if k == Config.KeyAutoStart then
        Config.AutoStart = not Config.AutoStart
        UI.UpdateStatus("AutoStart", Config.AutoStart); return
    end
    if k == Config.KeyToggleKiting then
        Config.EnableKiting = not Config.EnableKiting
        UI.UpdateStatus("EnableKiting", Config.EnableKiting); return
    end
    if k == Config.KeySpeedUp then
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = math.min(h.WalkSpeed + 2, 50) end
        return
    end
    if k == Config.KeySpeedDown then
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = math.max(h.WalkSpeed - 2, 16) end
        return
    end
    if k == Config.KeyDebug then AutoTarget.DebugListEnemies(); return end
    if k == Config.KeyToggleVisualize then Visualize.Toggle(); return end
    if k == Config.KeyPanic then
        State.Running = false
        Config.AutoFarm = false; Config.AutoSkill = false
        Config.AutoStart = false; Config.AutoAttack = false
        for _, d in pairs(ToggleButtons) do
            if d.setValue then d.setValue(false) end
        end
        Pathfinding.Stop()
        print("[V35] PANIC!")
    end
end

local function mainLoop()
    State.Running = true
    print("[V35] Main loop!")
    while State.Running do
        local dt = RunService.Heartbeat:Wait()
        if Config.AutoStart then pcall(AutoStart.Update, dt) end
        if Config.CustomWalkSpeed then pcall(WalkSpeed.Update, dt) end
        if Config.AutoFarm then pcall(AutoFarm.Update, dt) end
        if Config.AutoSkill then pcall(AutoSkill.Update, dt) end
        if VisualizeEnabled then pcall(Visualize.Update) end
        pcall(UI.Update)
    end
end

