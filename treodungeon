    "quái", "quai", "thú", "thu", "quỷ", "quy",
}

local function isFriendlyName(name)
    local n = name:lower()
    return n:find("npc") or n:find("friendly")
        or n:find("vendor") or n:find("shop")
        or n:find("trainer") or n:find("quest")
        or n:find("dialog") or n:find("guide")
end

local function isEnemy(obj)
    if not obj or not obj:IsA("Model") then return false end
    if obj == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 or h.MaxHealth <= 0 then return false end
    local hasRoot = obj:FindFirstChild("HumanoidRootPart")
                 or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("Torso")
                 or obj:FindFirstChild("Head") or obj.PrimaryPart
    if not hasRoot then return false end
    local name = obj.Name
    if isFriendlyName(name) then return false end
    if obj:FindFirstChild("enemyNameplate", true) then return true end
    local ok, tags = pcall(function() return CollectionService:GetTags(obj) end)
    if ok and tags then
        for _, tag in pairs(tags) do
            local tl = tostring(tag):lower()
            if tl:find("enem") or tl:find("mob") or tl:find("monster")
               or tl:find("boss") or tl:find("hostile") then return true end
        end
    end
    local ok2, eAttr = pcall(function()
        return obj:GetAttribute("Enemy") or obj:GetAttribute("IsEnemy")
            or obj:GetAttribute("enemy") or obj:GetAttribute("isEnemy")
            or obj:GetAttribute("Monster") or obj:GetAttribute("Hostile")
    end)
    if ok2 and eAttr then return true end
    local n = name:lower()
    for _, kw in pairs(ENEMY_NAME_KEYWORDS) do
        if n:find(kw) then return true end
    end
    local parent = obj.Parent
    local depth = 0
    while parent and parent ~= workspace and depth < 5 do
        local pname = parent.Name:lower()
        for _, kw in pairs(ENEMY_FOLDER_KEYWORDS) do
            if pname:find(kw) then return true end
        end
        parent = parent.Parent
        depth = depth + 1
    end
    local otherPlayers = 0
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then otherPlayers = otherPlayers + 1 end
    end
    if otherPlayers == 0 and obj:FindFirstChild("HumanoidRootPart") then return true end
    return false
end

local function recursiveCollect(root, list, depth, maxDepth)
    for _, obj in pairs(root:GetChildren()) do
        if obj:IsA("Model") then
            table.insert(list, obj)
            if depth < maxDepth then recursiveCollect(obj, list, depth + 1, maxDepth) end
        elseif obj:IsA("Folder") then
            if depth < maxDepth then recursiveCollect(obj, list, depth + 1, maxDepth) end
        end
    end
end

local function updateModelCache(forceRefresh)
    if not forceRefresh and not CacheDirty
       and tick() - LastCacheUpdate < Config.CacheInterval then return end
    LastCacheUpdate = tick()
    CacheDirty = false
    local newCache = {}
    recursiveCollect(workspace, newCache, 1, Config.MaxScanDepth)
    ModelCache = newCache
end

local function scoreEnemy(obj, myPos, isCurrentTarget)
    local pos = getPos(obj)
    if not pos then return math.huge end
    local d = (pos - myPos).Magnitude
    local hp, maxHp = getHP(obj)
    local hpRatio = hp / math.max(maxHp, 1)
    local score = d
    if hpRatio < 0.15 then score = score * 0.3
    elseif hpRatio < 0.3 then score = score * 0.5
    elseif hpRatio < 0.5 then score = score * 0.8 end
    if BossDetect.IsBoss(obj) then score = score * 0.85 end
    if isCurrentTarget then score = score * 0.5 end
    return score
end

function AutoTarget.GetBestEnemy()
    local c = LocalPlayer.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    updateModelCache()
    local best, bestScore = nil, math.huge
    local rangeSq = Config.FarmRange * Config.FarmRange
    local cur = _G.CurrentTarget
    for _, obj in pairs(ModelCache) do
        if obj.Parent and isEnemy(obj) then
            local pos = getPos(obj)
            if pos then
                local dSq = (pos - myPos).Magnitude ^ 2
                if dSq <= rangeSq then
                    local sc = scoreEnemy(obj, myPos, cur == obj)
                    if sc < bestScore then bestScore = sc; best = obj end
                end
            end
        end
    end
    if not best then
        updateModelCache(true)
        for _, obj in pairs(ModelCache) do
            if obj.Parent and isEnemy(obj) then
                local pos = getPos(obj)
                if pos then
                    local d = (pos - myPos).Magnitude
                    if d <= Config.FarmRange then
                        if not best or d < bestScore then best = obj; bestScore = d end
                    end
                end
            end
        end
    end
    return best
end

function AutoTarget.CountEnemies()
    local c = LocalPlayer.Character
    if not c then return 0 end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return 0 end
    local myPos = hrp.Position
    updateModelCache()
    local count = 0
    local rangeSq = Config.FarmRange * Config.FarmRange
    for _, obj in pairs(ModelCache) do
        if obj.Parent and isEnemy(obj) then
            local pos = getPos(obj)
            if pos and (pos - myPos).Magnitude ^ 2 <= rangeSq then count = count + 1 end
        end
    end
    return count
end

function AutoTarget.ForceRescan()
    CacheDirty = true
    updateModelCache(true)
end

