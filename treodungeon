-- 5. BODYGYRO & ĐIỀU HƯỚNG V33/V35
-- ====================================================================
local Smooth = {}
local GyroCache = setmetatable({}, {__mode = "k"})

function Smooth.GetGyro(hrp)
    if not hrp or not hrp.Parent then return nil end
    local bg = GyroCache[hrp]
    if bg and bg.Parent then return bg end
    local old = hrp:FindFirstChild("AutoFarmGyro")
    if old then old:Destroy() end
    bg = Instance.new("BodyGyro")
    bg.Name = "AutoFarmGyro"
    bg.MaxTorque = Vector3.new(400000, 400000, 400000)
    bg.P = Config.GyroPower
    bg.D = Config.GyroDamping
    bg.Parent = hrp
    GyroCache[hrp] = bg
    return bg
end

function Smooth.FaceTarget(hrp, targetPos)
    if not hrp or not hrp.Parent or not targetPos then return end
    local bg = Smooth.GetGyro(hrp)
    if not bg then return end
    local toTarget = Vector3.new(targetPos.X - hrp.Position.X, 0, targetPos.Z - hrp.Position.Z)
    if toTarget.Magnitude < 0.1 then return end
    bg.CFrame = CFrame.lookAt(Vector3.zero, toTarget.Unit)
end

function Smooth.RemoveGyro(hrp)
    if not hrp then return end
    local bg = hrp:FindFirstChild("AutoFarmGyro")
    if bg then bg:Destroy() end
    GyroCache[hrp] = nil
end

function Smooth.DisableAutoRotate(h)
    if h and h.AutoRotate then h.AutoRotate = false end
end

