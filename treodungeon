UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.F2 then tFarm.Set(not Config.AutoFarm)
    elseif input.KeyCode == Enum.KeyCode.F6 then tSkills.Set(not Config.AutoSkill)
