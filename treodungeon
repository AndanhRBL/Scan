local AutoTarget = {}
local ModelCache = {}
local LastCacheUpdate = 0
local CacheDirty = true

local ENEMY_NAME_KEYWORDS = {
    "enemy", "mob", "monster", "boss", "slime", "goblin", "orc",
    "skeleton", "zombie", "demon", "oni", "guardian", "warrior",
    "knight", "brute", "golem", "troll", "wraith", "ghost",
    "spider", "crab", "shark", "serpent", "kraken", "cannon",
    "turret", "mage", "wizard", "ranger", "bandit", "pirate",
    "yeti", "wolf", "bear", "ogre", "imp", "fiend", "cultist",
    "peasant", "soldier", "archer", "assassin", "berserker",
    "sand", "desert", "lava", "ice", "fire", "water",
    "dummy", "training", "target", "minion", "summon",
    "vampire", "werewolf", "giant", "elite", "dragon",
    "quái", "quai", "thú", "thu", "quỷ", "quy",
    "mummy", "chimera", "cryonox", "swashbuckler", "blackbeard",
    "azrallik", "musashi", "overlord", "varosh", "odin", "viking",
}

local ENEMY_FOLDER_KEYWORDS = {
    "enemies", "enem", "mob", "monster", "boss", "target", "npc",
    "dungeon", "creature", "hostile", "quai", "spawn",
}

local function isFriendlyName(name)
    local n = name:lower()
    return n:find("vendor") or n:find("shop") or n:find("trainer") or n:find("dialog") or n:find("guide")
end

local function isEnemy(obj)
    if not obj or not obj:IsA("Model") then return false end
    if obj == LocalPlayer.Character then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end

    local h = obj:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 or h.MaxHealth <= 0 then return false end

    local hasRoot = obj:FindFirstChild("HumanoidRootPart")
                 or obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("Torso")
                 or obj:FindFirstChild("Head") or obj.PrimaryPart
    if not hasRoot then return false end

    local name = obj.Name
    if isFriendlyName(name) then return false end

    -- Bất kỳ model nào có Humanoid sống trong Dungeon mà không phải người chơi đều là Quái!
    if not isLobby() and not Players:GetPlayerFromCharacter(obj) then
        return true
    end

    if obj:FindFirstChild("enemyNameplate", true) then return true end

    local ok, tags = pcall(function() return CollectionService:GetTags(obj) end)
    if ok and tags then
        for _, tag in pairs(tags) do
            local tl = tostring(tag):lower()
            if tl:find("enem") or tl:find("mob") or tl:find("monster")
               or tl:find("boss") or tl:find("hostile") then return true end
        end
    end

    local ok2, eAttr = pcall(function()
        return obj:GetAttribute("Enemy") or obj:GetAttribute("IsEnemy")
            or obj:GetAttribute("enemy") or obj:GetAttribute("isEnemy")
            or obj:GetAttribute("Monster") or obj:GetAttribute("Hostile")
    end)
    if ok2 and eAttr then return true end

    local n = name:lower()
    for _, kw in pairs(ENEMY_NAME_KEYWORDS) do
        if n:find(kw) then return true end
    end

    local parent = obj.Parent
    local depth = 0
    while parent and parent ~= workspace and depth < 5 do
        local pname = parent.Name:lower()
        for _, kw in pairs(ENEMY_FOLDER_KEYWORDS) do
            if pname:find(kw) then return true end
        end
        parent = parent.Parent
        depth = depth + 1
    end

    return false
end

local function recursiveCollect(root, list, depth, maxDepth)
    for _, obj in pairs(root:GetChildren()) do
        if obj:IsA("Model") then
            table.insert(list, obj)
            if depth < maxDepth then recursiveCollect(obj, list, depth + 1, maxDepth) end
        elseif obj:IsA("Folder") then
            if depth < maxDepth then recursiveCollect(obj, list, depth + 1, maxDepth) end
        end
    end
end

local function updateModelCache(forceRefresh)
    if not forceRefresh and not CacheDirty
       and tick() - LastCacheUpdate < Config.CacheInterval then return end
    LastCacheUpdate = tick()
    CacheDirty = false
    local newCache = {}
    recursiveCollect(workspace, newCache, 1, Config.MaxScanDepth)
    ModelCache = newCache
end

local function scoreEnemy(obj, myPos, isCurrentTarget)
    local pos = getPos(obj)
    if not pos then return math.huge end
    local d = (pos - myPos).Magnitude
    local hp, maxHp = getHP(obj)
    local hpRatio = hp / math.max(maxHp, 1)
    local score = d
    if hpRatio < 0.15 then score = score * 0.3
    elseif hpRatio < 0.3 then score = score * 0.5
    elseif hpRatio < 0.5 then score = score * 0.8 end
    if BossDetect.IsBoss(obj) then score = score * 0.85 end
    if isCurrentTarget then score = score * 0.5 end
    return score
end

function AutoTarget.GetBestEnemy()
    local c = LocalPlayer.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    updateModelCache()
    local best, bestScore = nil, math.huge
    local rangeSq = Config.FarmRange * Config.FarmRange
    local cur = _G.CurrentTarget

    for _, obj in pairs(ModelCache) do
        if obj.Parent and isEnemy(obj) then
            local pos = getPos(obj)
            if pos then
                local dSq = (pos - myPos).Magnitude ^ 2
                if dSq <= rangeSq then
                    local sc = scoreEnemy(obj, myPos, cur == obj)
                    if sc < bestScore then bestScore = sc; best = obj end
                end
            end
        end
    end

    if not best then
        updateModelCache(true)
        for _, obj in pairs(ModelCache) do
            if obj.Parent and isEnemy(obj) then
                local pos = getPos(obj)
                if pos then
                    local d = (pos - myPos).Magnitude
                    if d <= Config.FarmRange then
                        if not best or d < bestScore then best = obj; bestScore = d end
                    end
                end
            end
        end
    end
    return best
end

function AutoTarget.FindNearestChest()
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local nearest, nearDist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and (obj.Name:lower():find("chest") or obj.Name:lower():find("reward")) then
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt", true)
            if prompt then
                local pos = obj:IsA("BasePart") and obj.Position or getPos(obj)
                if pos then
                    local d = (pos - myPos).Magnitude
                    if d < nearDist and d <= 100 then nearDist = d; nearest = obj end
                end
            end
        end
    end
    return nearest
end

function AutoTarget.FindNearestPortal()
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local nearest, nearDist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            if name:find("portal") or name:find("door") or name:find("exit") or name:find("bossroom") or name:find("gate") then
                local pos = obj:IsA("BasePart") and obj.Position or getPos(obj)
                if pos then
                    local d = (pos - myPos).Magnitude
                    if d < nearDist and d <= 300 then nearDist = d; nearest = obj end
                end
            end
        end
    end
    return nearest
end

function AutoTarget.ForceRescan()
    CacheDirty = true
    updateModelCache(true)
end

AutoTarget.Initialize = function()
    ModelCache = {}
    LastCacheUpdate = 0
    CacheDirty = true
end

-- =====================================================
-- AUTO FARM
-- =====================================================
local AutoFarm = {}
local CurrentTarget = nil
local LastTargetSearch = 0
local LastWeaponAttack = 0
local LastMoveAction = 0

function AutoFarm.Update(dt)
    if not Config.AutoFarm then return end
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not h or not hrp or h.Health <= 0 then return end

    Smooth.DisableAutoRotate(h)

    if State.StuckTime > Config.StuckDropTargetTime then
        CurrentTarget = nil; _G.CurrentTarget = nil
        State.StuckTime = 0
        Pathfinding.Reset()
    end

    if State.StuckTime > 3 and tick() - LastTargetSearch > 2 then
        AutoTarget.ForceRescan()
        State.StuckTime = 0
        LastTargetSearch = tick() - Config.TargetSearchInterval
    end

    if tick() - LastTargetSearch > Config.TargetSearchInterval then
        if CurrentTarget then
            local hp = getHP(CurrentTarget)
            if not CurrentTarget.Parent or hp <= 0 then
                CurrentTarget = nil; _G.CurrentTarget = nil
                State.KillCount = State.KillCount + 1
                Pathfinding.Stop()
                Obstacle.ClearWaypoints()
                Kiting.Reset()
            end
        end

        if not CurrentTarget then
            CurrentTarget = AutoTarget.GetBestEnemy()
            _G.CurrentTarget = CurrentTarget
            if CurrentTarget then
                Obstacle.ClearWaypoints()
                Kiting.Reset()
                Pathfinding.Reset()
            else
                if Config.AutoOpenChest then
                    local chest = AutoTarget.FindNearestChest()
                    if chest then
                        local pos = chest:IsA("BasePart") and chest.Position or getPos(chest)
                        if pos then
                            local d = (pos - hrp.Position).Magnitude
                            if d <= 10 then
                                local prompt = chest:FindFirstChildOfClass("ProximityPrompt", true)
                                if prompt then
                                    pcall(function()
                                        prompt:InputHoldBegin()
                                        task.wait(prompt.HoldDuration or 0.5)
                                        prompt:InputHoldEnd()
                                    end)
                                end
                            elseif d <= 150 then
                                Pathfinding.MoveTo(pos, dt, pos)
                            end
                        end
                    end
                end

                if Config.AutoClearRoom then
                    local portal = AutoTarget.FindNearestPortal()
                    if portal then
                        local pos = portal:IsA("BasePart") and portal.Position or getPos(portal)
                        if pos then
                            local d = (pos - hrp.Position).Magnitude
                            if d <= 5 then
                                h:MoveTo(hrp.Position)
                            elseif d <= 250 then
                                Pathfinding.MoveTo(pos, dt, pos)
                            end
                        end
                    end
                end
            end
        end
        LastTargetSearch = tick()
    end

    if CurrentTarget and CurrentTarget.Parent then
        local pos = getPos(CurrentTarget)
        if pos then
            local d = (pos - hrp.Position).Magnitude
            local facePos = Vector3.new(pos.X, hrp.Position.Y, pos.Z)

            local function tryAttack(rangeBonus)
                rangeBonus = rangeBonus or 0
                if d <= Config.AttackRange + rangeBonus and Config.AutoAttack and tick() - LastWeaponAttack >= Config.AttackCooldown then
                    local tool = c:FindFirstChildOfClass("Tool")
                    if tool then
                        pcall(function() tool:Activate() end)
                        LastWeaponAttack = tick()
                    end
                    local remotes = ReplicatedStorage:FindFirstChild("remotes")
                    local swingRemote = remotes and (remotes:FindFirstChild("swingSword") or remotes:FindFirstChild("attack"))
                    if swingRemote then
                        pcall(function() swingRemote:FireServer() end)
                    end
                end
            end

            if Config.EnableKiting then
                local kitePos, kiteAction = Kiting.GetKitePosition(hrp, pos, CurrentTarget, dt)
                if kiteAction == "retreat" and kitePos then
                    Pathfinding.MoveTo(kitePos, dt, facePos)
                    tryAttack(5)
                elseif kiteAction == "circle" and kitePos then
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        Pathfinding.MoveTo(kitePos, dt, facePos)
                    end
                    tryAttack(8)
                elseif kiteAction == "attack" then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(0)
                elseif kiteAction == "hold" then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(0)
                elseif kiteAction == "approach" then
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        local predictTarget = pos
                        if Config.PredictMovement then
                            local vel = getVelocity(CurrentTarget)
                            if vel.Magnitude > 1 then
                                local timeToReach = math.min(d / math.max(h.WalkSpeed, 16), 1.0)
                                predictTarget = pos + vel * timeToReach * 0.7
                            end
                        end
                        Pathfinding.MoveTo(predictTarget, dt, facePos)
                    end
                    tryAttack(0)
                end
            else
                if d <= Config.AttackRange then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(0)
                else
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        Pathfinding.MoveTo(pos, dt, facePos)
                    end
                end
            end
        end
    end
end

AutoFarm.Initialize = function()
    CurrentTarget = nil
    _G.CurrentTarget = nil
    LastTargetSearch = 0
    LastWeaponAttack = 0
    LastMoveAction = 0
end

