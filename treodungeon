-- AUTO SKILL
-- =====================================================
local AutoSkill = {}
local LastCast = 0
local SkillIdx = 1

local function findToolByName(name)
    for _, cont in pairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
        if cont then
            for _, t in pairs(cont:GetChildren()) do
                if t:IsA("Tool") and t.Name == name then return t end
            end
        end
    end
    return nil
end

local function findSlot(slot)
    for _, cont in pairs({LocalPlayer:FindFirstChild("Backpack"), LocalPlayer.Character}) do
        if cont then
            for _, t in pairs(cont:GetChildren()) do
                if t:IsA("Tool") then
                    local a = t:FindFirstChild("abilitySlot")
                    if a and a.Value == slot then return t end
                end
            end
        end
    end
    return nil
end

local function castTool(tool)
    if not tool then return false end
    local cd = tool:FindFirstChild("cooldown")
    if cd and cd.Value > 0 then return false end
    if Config.UseLocalEvent then
        local le = tool:FindFirstChild("localEvent")
        if le then pcall(function() le:Fire() end); return true end
    end
    for _, rn in pairs({"spellEvent","abilityEvent","fireballShootEvent"}) do
        local r = tool:FindFirstChild(rn)
        if r then pcall(function() r:FireServer() end); return true end
    end
    return false
end

local function getNextSkill()
    local priority = Config.SkillPriority
    if #priority == 0 then priority = {"q", "e", "q2", "e2"} end
    for i = 1, #priority do
        local idx = ((SkillIdx + i - 2) % #priority) + 1
        local nameOrSlot = priority[idx]
        local t = findSlot(nameOrSlot) or findToolByName(nameOrSlot)
        if t then
            local cd = t:FindFirstChild("cooldown")
            if cd and cd.Value <= 0 then SkillIdx = idx; return t end
        end
    end
    return nil
end

function AutoSkill.Update(dt)
    if not Config.AutoSkill then return end
    if tick() - LastCast < Config.SkillDelay then return end
    local c = LocalPlayer.Character
    if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return end
    local bc = c:FindFirstChild("busyCasting")
    if bc and bc.Value == true then return end
    if not _G.CurrentTarget or not _G.CurrentTarget.Parent then return end
    local t = getNextSkill()
    if t and castTool(t) then LastCast = tick() end
end

AutoSkill.Initialize = function()
    LastCast = 0
    SkillIdx = 1
    print("[AutoSkill] OK")
end

