function AutoTarget.FindNearestChest()
    local c = LocalPlayer.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local nearest, nearDist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local isChest = obj.Name:lower():find("chest") or obj.Name:lower():find("reward")
            if isChest then
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt", true)
                if prompt then
                    local pos = obj:IsA("BasePart") and obj.Position or getPos(obj)
                    if pos then
                        local d = (pos - myPos).Magnitude
                        if d < nearDist and d <= 100 then nearDist = d; nearest = obj end
                    end
                end
            end
        end
    end
    return nearest
end

function AutoTarget.FindNearestPortal()
    local c = LocalPlayer.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local myPos = hrp.Position
    local nearest, nearDist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = obj.Name:lower()
            local isPortal = name:find("portal") or name:find("door") or name:find("exit") or name:find("next")
            if isPortal then
                local pos = obj:IsA("BasePart") and obj.Position or getPos(obj)
                if pos then
                    local d = (pos - myPos).Magnitude
                    if d < nearDist and d <= 300 then nearDist = d; nearest = obj end
                end
            end
        end
    end
    return nearest
end

