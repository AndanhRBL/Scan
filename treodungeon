local function createStepper(parent, text, options, defaultVal, callback)
    local row = Instance.new("Frame", parent); row.Size = UDim2.new(1, 0, 0, 27); row.BackgroundTransparency = 1
    local label = Instance.new("TextLabel", row)
    label.Size = UDim2.new(0.32, 0, 1, 0); label.Position = UDim2.new(0, 4, 0, 0); label.BackgroundTransparency = 1
    label.Text = text; label.TextColor3 = Color3.fromRGB(220, 225, 235); label.Font = Enum.Font.GothamMedium; label.TextSize = 11; label.TextXAlignment = Enum.TextXAlignment.Left

    local container = Instance.new("Frame", row)
    container.Size = UDim2.new(0.65, 0, 0, 24); container.Position = UDim2.new(0.34, 0, 0.5, -12)
    container.BackgroundColor3 = Color3.fromRGB(24, 28, 36)
    Instance.new("UICorner", container).CornerRadius = UDim.new(0, 5)
    local stroke = Instance.new("UIStroke", container); stroke.Thickness = 1; stroke.Color = Color3.fromRGB(48, 54, 68)

    local prevBtn = Instance.new("TextButton", container)
    prevBtn.Size = UDim2.new(0, 22, 1, 0); prevBtn.Position = UDim2.new(0, 0, 0, 0); prevBtn.BackgroundTransparency = 1
    prevBtn.Text = "◀"; prevBtn.TextColor3 = Color3.fromRGB(255, 42, 75); prevBtn.Font = Enum.Font.GothamBold; prevBtn.TextSize = 10

    local valBtn = Instance.new("TextButton", container)
    valBtn.Size = UDim2.new(1, -44, 1, 0); valBtn.Position = UDim2.new(0, 22, 0, 0); valBtn.BackgroundTransparency = 1
    valBtn.Text = tostring(defaultVal); valBtn.TextColor3 = Color3.fromRGB(255, 255, 255); valBtn.Font = Enum.Font.GothamBold; valBtn.TextSize = 10

    local nextBtn = Instance.new("TextButton", container)
    nextBtn.Size = UDim2.new(0, 22, 1, 0); nextBtn.Position = UDim2.new(1, -22, 0, 0); nextBtn.BackgroundTransparency = 1
    nextBtn.Text = "▶"; nextBtn.TextColor3 = Color3.fromRGB(255, 42, 75); nextBtn.Font = Enum.Font.GothamBold; nextBtn.TextSize = 10

    local currentIndex = 1
    for i, opt in ipairs(options) do
        if opt == defaultVal then currentIndex = i; break end
    end

    local function updateVal(idx, trigger)
        currentIndex = idx
        valBtn.Text = tostring(options[currentIndex])
        if trigger then callback(options[currentIndex]) end
    end

    prevBtn.MouseButton1Click:Connect(function()
        local nextIdx = currentIndex - 1
        if nextIdx < 1 then nextIdx = #options end
        updateVal(nextIdx, true)
    end)
    nextBtn.MouseButton1Click:Connect(function()
        local nextIdx = currentIndex + 1
        if nextIdx > #options then nextIdx = 1 end
        updateVal(nextIdx, true)
    end)
    valBtn.MouseButton1Click:Connect(function()
        local nextIdx = currentIndex + 1
        if nextIdx > #options then nextIdx = 1 end
        updateVal(nextIdx, true)
    end)

    return {
        Set = function(val)
            for i, opt in ipairs(options) do
                if opt == val then updateVal(i, false); break end
            end
        end,
        Get = function() return options[currentIndex] end
    }
end

