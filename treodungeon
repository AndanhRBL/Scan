-- =====================================================
-- UTILS
-- =====================================================
local function getPos(obj)
    if not obj or not obj.Parent then return nil end
    local hrp = obj:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if h and h.RootPart then return h.RootPart.Position end
    local pp = obj.PrimaryPart
    if pp then return pp.Position end
    local torso = obj:FindFirstChild("UpperTorso") or obj:FindFirstChild("Torso")
    if torso then return torso.Position end
    local head = obj:FindFirstChild("Head")
    if head then return head.Position end
    local bp = obj:FindFirstChildWhichIsA("BasePart")
    if bp then return bp.Position end
    return nil
end

local function getHP(obj)
    if not obj then return 0, 1 end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if h then return h.Health, h.MaxHealth end
    return 100, 100
end

local function getVelocity(obj)
    local hrp = obj:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.AssemblyLinearVelocity end
    local pp = obj.PrimaryPart
    if pp then return pp.AssemblyLinearVelocity end
    return Vector3.new(0, 0, 0)
end

local function isKeywordMatch(text, keywords)
    if not text then return false end
    local lower = text:lower()
    for _, kw in pairs(keywords) do
        if lower:find(kw) then return true end
    end
    return false
end

-- =====================================================
-- BOSS DETECTION (giữ để phân loại, KHÔNG dùng để rush)
-- =====================================================
local BossDetect = {}

function BossDetect.IsBoss(obj)
    if not obj or not obj.Parent then return false end
    local name = obj.Name:lower()
    if name:find("boss") or name:find("giant") or name:find("lord")
       or name:find("king") or name:find("titan") or name:find("elite")
       or name:find("champion") or name:find("dragon") or name:find("demon")
       or name:find("final") or name:find("overlord") or name:find("ancient")
       or name:find("behemoth") or name:find("colossus") or name:find("primordial") then
        return true
    end
    local h = obj:FindFirstChildOfClass("Humanoid")
    if h and h.MaxHealth >= 2000 then return true end
    local ok, tags = pcall(function() return CollectionService:GetTags(obj) end)
    if ok and tags then
        for _, tag in pairs(tags) do
            local tl = tostring(tag):lower()
            if tl:find("boss") or tl:find("elite") or tl:find("champion") then
                return true
            end
        end
    end
    if obj:FindFirstChild("bossHealthBar", true) or obj:FindFirstChild("BossHealth", true) then
        return true
    end
    return false
end

-- =====================================================
-- BODYGYRO (V33)
-- =====================================================
local Smooth = {}
local GyroCache = setmetatable({}, {__mode = "k"})

function Smooth.GetGyro(hrp)
    if not hrp or not hrp.Parent then return nil end
    local bg = GyroCache[hrp]
    if bg and bg.Parent then return bg end
    local old = hrp:FindFirstChild("AutoFarmGyro")
    if old then old:Destroy() end
    bg = Instance.new("BodyGyro")
    bg.Name = "AutoFarmGyro"
    bg.MaxTorque = Vector3.new(400000, 400000, 400000)
    bg.P = Config.GyroPower
    bg.D = Config.GyroDamping
    bg.Parent = hrp
    GyroCache[hrp] = bg
    return bg
end

function Smooth.FaceTarget(hrp, targetPos)
    if not hrp or not hrp.Parent or not targetPos then return end
    local bg = Smooth.GetGyro(hrp)
    if not bg then return end
    local toTarget = Vector3.new(
        targetPos.X - hrp.Position.X, 0,
        targetPos.Z - hrp.Position.Z
    )
    if toTarget.Magnitude < 0.1 then return end
    toTarget = toTarget.Unit
    bg.CFrame = CFrame.lookAt(Vector3.zero, toTarget)
end

function Smooth.DisableAutoRotate(h)
    if h and h.AutoRotate then h.AutoRotate = false end
end

