local CombatGyro = {}
local currentGyro = nil

function CombatGyro.GetOrCreate(root)
    if not root then return nil end
    if currentGyro and currentGyro.Parent == root then return currentGyro end
    if currentGyro then pcall(function() currentGyro:Destroy() end) end
    local existing = root:FindFirstChild("ReaperCombatGyro")
    if existing then currentGyro = existing; return currentGyro end

    local g = Instance.new("BodyGyro")
    g.Name = "ReaperCombatGyro"
    g.MaxTorque = Vector3.new(0, 0, 0)
    g.P = Config.GyroPower
    g.D = Config.GyroDamping
    g.Parent = root
    currentGyro = g
    return currentGyro
end

function CombatGyro.FaceTarget(root, targetPos)
    local g = CombatGyro.GetOrCreate(root)
    if not g or not root or not targetPos then return end
    g.MaxTorque = Vector3.new(0, Config.GyroPower, 0)
    g.CFrame = CFrame.new(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
end

function CombatGyro.Disable()
    if currentGyro and currentGyro.Parent then
        currentGyro.MaxTorque = Vector3.zero
    end
end

