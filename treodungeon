-- 6. HỆ THỐNG DÒ LASER & CHIÊU THỨC BOSS (DUAL-LAYER DODGE)
-- ====================================================================
local DodgeSystem = {}

local function isPointInLaserBox(pt, cframe, size, buffer)
    local rel = cframe:PointToObjectSpace(pt)
    local hx = (size.X / 2) + buffer
    local hy = (size.Y / 2) + buffer
    local hz = (size.Z / 2) + buffer
    return math.abs(rel.X) <= hx and math.abs(rel.Y) <= hy and math.abs(rel.Z) <= hz
end

function DodgeSystem.ScanThreats()
    local myChar = LocalPlayer.Character
    if not myChar then return {} end
    local myRoot = getRoot(myChar)
    if not myRoot then return {} end
    local myPos = myRoot.Position

    local threats = {}

    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") then
            local n = part.Name:lower()
            local isLaser = n:find("laser") or n:find("beam") or n:find("line") or n:find("telegraph") or n:find("precast")
            local isAoe = n:find("aoe") or n:find("zone") or n:find("circle") or n:find("ring") or n:find("blast")

            if (isLaser or isAoe) and part.Transparency < 1 then
                local dist = (part.Position - myPos).Magnitude
                if dist < 80 then
                    table.insert(threats, {
                        Part = part,
                        Type = isLaser and "Laser" or "Aoe",
                        CFrame = part.CFrame,
                        Size = part.Size,
                        Position = part.Position,
                        Radius = math.max(part.Size.X, part.Size.Z) / 2 + Config.DodgeBuffer
                    })
                end
            end
        end
    end
    return threats
end

function DodgeSystem.IsPositionDangerous(pos, threats)
    for _, t in ipairs(threats) do
        if t.Type == "Laser" then
            if isPointInLaserBox(pos, t.CFrame, t.Size, Config.DodgeBuffer) then
                return true, t
            end
        else
            if (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(t.Position.X, 0, t.Position.Z)).Magnitude <= t.Radius then
                return true, t
            end
        end
    end
    return false, nil
end

