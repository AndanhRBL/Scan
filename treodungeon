local AutoTarget = {}
local TargetCache = {}
local LastScanTime = 0
function AutoTarget.GetEnemies()
    local enemies = {}
    local dungeon = workspace:FindFirstChild("dungeon")
    if dungeon then
        local folder = dungeon:FindFirstChild("enemies")
        if folder then
            for _, e in ipairs(folder:GetChildren()) do
                if getHP(e) > 0 then table.insert(enemies, e) end
            end
        end
    end
    return enemies
end
function AutoTarget.GetBestEnemy()
    local enemies = AutoTarget.GetEnemies()
    local c = LocalPlayer.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    if not hrp or #enemies == 0 then return nil end
    local best = nil
    local bestDist = math.huge
    for _, e in ipairs(enemies) do
        local pos = getPos(e)
        if pos then
            local dist = (pos - hrp.Position).Magnitude
            if dist < bestDist and dist <= Config.FarmRange then
                bestDist = dist
                best = e
            end
        end
    end
    return best
end
function AutoTarget.ForceRescan()
    TargetCache = {}
    LastScanTime = 0
end
-- =====================================================
-- AUTO FARM V45 (4-LAYER COMBAT & KITING ENGINE)
-- =====================================================
local AutoFarm = {}
local CurrentTarget = nil
local LastMoveAction = 0
local LastTargetSearch = 0
local LastWeaponAttack = 0
function AutoFarm.Update(dt)
    if not Config.AutoFarm then return end
    local c = LocalPlayer.Character
    if not c then return end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")
    if not hrp or not h or h.Health <= 0 then return end
    -- Check xem phó bản đã hoàn thành để Replay chưa
    local dungeon = workspace:FindFirstChild("dungeon")
    local bossRoom = dungeon and dungeon:FindFirstChild("bossRoom")
    local dungeonFinished = bossRoom and bossRoom:FindFirstChild("dungeonFinished")
    if dungeonFinished and dungeonFinished.Value == true then
        triggerReplayOrLobby()
        return
    end
    if tick() - LastTargetSearch > Config.TargetSearchInterval then
        LastTargetSearch = tick()
        if not CurrentTarget or not CurrentTarget.Parent or getHP(CurrentTarget) <= 0 then
            if CurrentTarget and getHP(CurrentTarget) <= 0 then
                State.KillCount = State.KillCount + 1
            end
            CurrentTarget = AutoTarget.GetBestEnemy()
            _G.CurrentTarget = CurrentTarget
            Pathfinding.Reset()
            Kiting.Reset()
        end
    end
    if CurrentTarget and CurrentTarget.Parent then
        local pos = getPos(CurrentTarget)
        if pos then
            local d = (pos - hrp.Position).Magnitude
            local facePos = Vector3.new(pos.X, hrp.Position.Y, pos.Z)
            -- =============================================
            -- HÀM TRYATTACK V45: HỆ THỐNG 4 TẦNG ĐÁNH VŨ KHÍ
            -- =============================================
            local function tryAttack(rangeBonus)
                rangeBonus = rangeBonus or 0
                if not Config.AutoAttack then return end
                if d > (Config.AttackRange + rangeBonus) then return end
                if tick() - LastWeaponAttack < Config.AttackCooldown then return end
                local attacked = false
                -- Không đánh nếu đang cast chiêu hoặc trong sảnh an toàn
                local bc = c:FindFirstChild("busyCasting")
                if bc and bc.Value == true then return end
                local peaceful = LocalPlayer:FindFirstChild("peaceful")
                if peaceful and peaceful.Value == true then return end
                -- [Tầng 1]: Native Dungeon Quest Weapon trong Accessory
                for _, acc in ipairs(c:GetChildren()) do
                    if acc:IsA("Accessory") and acc:FindFirstChild("Weapon") then
                        local weaponRemote = acc:FindFirstChildOfClass("RemoteEvent")
                        if weaponRemote then
                            pcall(function() weaponRemote:FireServer() end)
                            attacked = true
                        end
                    end
                end
                -- [Tầng 2]: Remote weaponUsed của Dungeon Quest
                local remotes = ReplicatedStorage:FindFirstChild("remotes")
                if remotes and remotes:FindFirstChild("weaponUsed") then
                    pcall(function() remotes.weaponUsed:FireServer() end)
                    attacked = true
                end
                -- [Tầng 3]: Tool Weapon Equip & Activate Fallback
                local tool = c:FindFirstChildOfClass("Tool")
                if not tool then
                    local bp = LocalPlayer:FindFirstChild("Backpack")
                    if bp then
                        for _, t in ipairs(bp:GetChildren()) do
                            if t:IsA("Tool") and not t:FindFirstChild("abilitySlot") then
                                pcall(function() h:EquipTool(t) end)
                                tool = t
                                break
                            end
                        end
                    end
                end
                if tool then
                    pcall(function() tool:Activate() end)
                    attacked = true
                end
                -- [Tầng 4]: VirtualUser Click chuột trái (Trực tiếp kích hoạt UIS.lua của game)
                pcall(function()
                    VirtualUser:Button1Down(Vector2.new(500, 500), workspace.CurrentCamera.CFrame)
                    VirtualUser:Button1Up(Vector2.new(500, 500), workspace.CurrentCamera.CFrame)
                    attacked = true
                end)
                if attacked then
                    LastWeaponAttack = tick()
                end
            end
            -- KITING VÀ ĐÁNH LIÊN TỤC TRONG MỌI HÀNH ĐỘNG
            if Config.EnableKiting then
                local kitePos, kiteAction = Kiting.GetKitePosition(hrp, pos, CurrentTarget, dt)
                if kiteAction == "retreat" and kitePos then
                    Pathfinding.MoveTo(kitePos, dt, facePos)
                    tryAttack(6)
                elseif kiteAction == "circle" and kitePos then
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        Pathfinding.MoveTo(kitePos, dt, facePos)
                    end
                    tryAttack(10)
                elseif kiteAction == "attack" then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(4)
                elseif kiteAction == "hold" then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(4)
                elseif kiteAction == "approach" then
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        local predictTarget = pos
                        if Config.PredictMovement then
                            local vel = CurrentTarget:FindFirstChild("HumanoidRootPart") and CurrentTarget.HumanoidRootPart.Velocity or Vector3.zero
                            if vel.Magnitude > 1 then
                                local timeToReach = math.min(d / math.max(h.WalkSpeed, 16), 1.0)
                                predictTarget = pos + vel * timeToReach * 0.7
                            end
                        end
                        Pathfinding.MoveTo(predictTarget, dt, facePos)
                    end
                    tryAttack(4)
                end
            else
                if d <= Config.AttackRange then
                    Pathfinding.StopAndFace(facePos)
                    tryAttack(4)
                else
                    if tick() - LastMoveAction > Config.MoveDelay then
                        LastMoveAction = tick()
                        Pathfinding.MoveTo(pos, dt, facePos)
                    end
                    tryAttack(4)
                end
            end
        end
    end
end
