local AutoStart = {}
local LastStartAction = 0
local LastStartCheck = 0

local function fireChangeStartValue()
    local remotes = ReplicatedStorage:FindFirstChild("remotes")
    if not remotes then return false end
    local cs = remotes:FindFirstChild("changeStartValue")
    local ru = remotes:FindFirstChild("readyUp")
    if cs then pcall(function() cs:FireServer() end) end
    if ru then pcall(function() ru:FireServer() end) end
    return cs ~= nil or ru ~= nil
end

local function findStartButton()
    local ws = workspace:FindFirstChild("start")
    if ws then
        for _, obj in pairs(ws:GetDescendants()) do
            if obj:IsA("TextButton") or obj:IsA("ImageButton") then return obj end
        end
    end
    local g = LocalPlayer:FindFirstChild("PlayerGui")
    if g then
        for _, guiName in pairs({"startButton", "readyButton", "countDownGui"}) do
            local sb = g:FindFirstChild(guiName)
            if sb then
                for _, obj in pairs(sb:GetDescendants()) do
                    if obj:IsA("TextButton") or obj:IsA("ImageButton") then return obj end
                end
            end
        end
        for _, obj in pairs(g:GetDescendants()) do
            if obj:IsA("TextButton") and (obj.Name:lower():find("start") or obj.Text:lower():find("start") or obj.Text:lower():find("ready")) then
                return obj
            end
        end
    end
    return nil
end

function AutoStart.Update(dt)
    if not Config.AutoStart then return end
    if tick() - LastStartCheck < 0.8 then return end
    LastStartCheck = tick()
    if tick() - LastStartAction < 2.5 then return end

    local dState = getDungeonState()

    -- 1. Nếu đang ở sảnh chờ bắt đầu trong Dungeon hoặc ở ngoài sảnh
    if dState == "waiting_start" or dState == "lobby" then
        selectBestDungeon()
        fireChangeStartValue()
        local btn = findStartButton()
        if btn then
            pcall(function()
                if firesignal then
                    firesignal(btn.MouseButton1Down)
                    firesignal(btn.MouseButton1Click)
                else
                    btn.MouseButton1Down:Fire()
                    btn.MouseButton1Click:Fire()
                end
            end)
            LastStartAction = tick()
            return
        end

        -- Nếu đang ở sảnh chính (Lobby 77649408247578) -> Tự tạo phòng & Start
        if isLobby() then
            pcall(function()
                local inLobby = false
                if workspace:FindFirstChild("games") then
                    for _, v in pairs(workspace.games.inLobby:GetChildren()) do
                        if v:FindFirstChild(LocalPlayer.Name) then inLobby = true; break end
                    end
                end
                local createLobby = Remotes:FindFirstChild("createLobby")
                local startDungeon = Remotes:FindFirstChild("startDungeon")
                if not inLobby and createLobby then
                    createLobby:InvokeServer(
                        Config.SelectedDungeon, Config.SelectedDifficulty, 0,
                        Config.Hardcore, true, false
                    )
                end
                if startDungeon then startDungeon:FireServer() end
                LastStartAction = tick()
            end)
        end
    end
end

