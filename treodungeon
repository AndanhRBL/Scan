local Kiting = {}
local TargetTypeCache = {}

local function checkTargetType(target)
    if not target then return "normal" end
    local cached = TargetTypeCache[target]
    if cached then return cached end
    local t = "normal"
    if BossDetect.IsBoss(target) then t = "boss"
    else
        local name = target.Name:lower()
        if name:find("archer") or name:find("mage") or name:find("wizard") or name:find("ranger") or name:find("turret") or name:find("cannon") then
            t = "ranged"
        end
    end
    TargetTypeCache[target] = t
    return t
end

function Kiting.GetIdealDistance(target)
    local t = checkTargetType(target)
    if t == "boss" then return Config.KiteDistanceBoss end
    if t == "ranged" then return Config.KiteDistanceRanged end
    return Config.KiteDistance
end

-- Phát hiện Enemy đang cast/attack qua AnimationTracks (Chuẩn V35)
local function isEnemyCastingOrAttacking(enemy)
    if not enemy or not enemy.Parent then return false end
    local h = enemy:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    local anim = h:FindFirstChildOfClass("Animator")
    if not anim then return false end
    for _, track in pairs(anim:GetPlayingAnimationTracks()) do
        if not track.Looped and track.Animation then
            local aname = (track.Animation.Name or ""):lower()
            if isKeywordMatch(aname, {
                "attack", "punch", "slash", "shoot", "beam", "spell",
                "skill", "smash", "swing", "strike", "combo", "slam",
                "stomp", "cast", "windup", "charge", "prepare", "warning",
                "telegraph", "channel", "ultimate", "bossattack",
            }) then return true end
        end
    end
    return false
end

-- Dò tìm vùng nguy hiểm Telegraphs (Laser đỏ, Vòng đỏ, Đạn xoắn V41)
local activeHazards = {}

local function checkHazardIntersection(rootPos, hazard)
    if hazard.shape == "Cube" or hazard.shape == "Block" then
        local rel = hazard.cframe:PointToObjectSpace(rootPos)
        local halfX = (hazard.size.X / 2) + Config.DodgeBuffer
        local halfZ = (hazard.size.Z / 2) + Config.DodgeBuffer
        local halfY = math.max(hazard.size.Y / 2, 6) + 4
        if math.abs(rel.X) <= halfX and math.abs(rel.Z) <= halfZ and math.abs(rel.Y) <= halfY then
            local escapeRelX = (rel.X >= 0) and (halfX + 3) or -(halfX + 3)
            local escapeRelZ = rel.Z
            if math.abs(rel.Z) > (halfZ - 3) then escapeRelZ = (rel.Z >= 0) and (halfZ + 3) or -(halfZ + 3) end
            return true, hazard.cframe:PointToWorldSpace(Vector3.new(escapeRelX, 0, escapeRelZ))
        end
    else
        local center = hazard.position or hazard.cframe.Position
        local radius = hazard.radius or (hazard.size and math.max(hazard.size.X, hazard.size.Z) / 2) or 12
        local safeDist = radius + Config.DodgeBuffer
        local flatDist = (Vector3.new(rootPos.X, 0, rootPos.Z) - Vector3.new(center.X, 0, center.Z)).Magnitude
        if flatDist < safeDist and math.abs(rootPos.Y - center.Y) < 14 then
            local dir = (Vector3.new(rootPos.X, 0, rootPos.Z) - Vector3.new(center.X, 0, center.Z))
            if dir.Magnitude < 0.1 then dir = Vector3.new(1, 0, 0) else dir = dir.Unit end
            return true, center + dir * (safeDist + 4)
        end
    end
    return false, nil
end

